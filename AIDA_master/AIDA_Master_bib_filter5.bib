@article{2007_cotton_acp,
  author = {Cotton, R. J. and Benz, S. and Field, P. R. and Moehler, O. and Schnaiter, M.},
  title = {Technical note:: A numerical test-bed for detailed ice nucleation studies in the AIDA cloud simulation chamber},
  journal = {ATMOSPHERIC CHEMISTRY AND PHYSICS},
  year = {2007},
  volume = {7},
  pages = {243-256},
  month = {JAN 18},
  abstract = {The AIDA (Aerosol Interactions and Dynamics in the Atmosphere) aerosol and cloud chamber of Forschungszentrum Karlsruhe can be used to test the ice forming ability of aerosols. The AIDA chamber is extensively instrumented including pressure, temperature and humidity sensors, and optical particle counters. Expansion cooling using mechanical pumps leads to ice supersaturation conditions and possible ice formation. In order to describe the evolving chamber conditions during an expansion, a parcel model was modified to account for diabatic heat and moisture interactions with the chamber walls. Model results are shown for a series of expansions where the initial chamber temperature ranged from -20 degrees C to -60 degrees C and which used desert dust as ice forming nuclei. During each expansion, the initial formation of ice particles was clearly observed. For the colder expansions there were two clear ice nucleation episodes. In order to test the ability of the model to represent the changing chamber conditions and to give confidence in the observations of chamber temperature and humidity, and ice particle concentration and mean size, ice particles were simply added as a function of time so as to reproduce the observations of ice crystal concentration. The time interval and chamber conditions over which ice nucleation occurs is therefore accurately known, and enables the model to be used as a test bed for different representations of ice formation.},
  publisher = {COPERNICUS PUBLICATIONS},
  address = {MAX-PLANCK-STR 13, KATHLENBURG-LINDAU, 37191, GERMANY},
  type = {Article},
  language = {English},
  affiliation = {Cotton, RJ (Corresponding Author), Met Off, Exeter EX1 3PB, Devon, England. Met Off, Exeter EX1 3PB, Devon, England. Forschungszentrum Karlsruhe, Inst Meteorol \& Climate Res, Karlsruhe, Germany.; Met Office; NSF National Center for Atmospheric Research},
  doi = {10.5194/acp-7-243-2007},
  issn = {1680-7316},
  keywords-plus = {OROGRAPHIC WAVE CLOUDS; PARTICLES; DUST; INTACC; MODEL; WATER},
  research-areas = {Environmental Sciences \& Ecology; Meteorology \& Atmospheric Sciences},
  web-of-science-categories = {Environmental Sciences; Meteorology \& Atmospheric Sciences},
  author-email = {richard.cotton@metoffice.gov.uk},
  affiliations = {Met Office - UK; Helmholtz Association; Karlsruhe Institute of Technology},
