@article{2026_abdelwahed_jar,
  author = {Abd El-Wahed, Aida A. and Ghazala, Naglaa A. and Elfeel, Mahmoud A. and Sayed, Sobhia S.},
  title = {Bee venom extraction methods: a comparative study on quantity and honey bee performance},
  journal = {JOURNAL OF APICULTURAL RESEARCH},
  year = {2026},
  volume = {65},
  number = {2, SI},
  pages = {365-373},
  month = {MAR 15},
  abstract = {Bee venom (BV) is one of the important bee products that has attracted significant investigation due to its biological properties. The expensive cost of BV and its economic worth are the main reasons for beekeepers' increasing interest in its production. There is, however, no standardized technology for collecting BV. The objective of this study is to understand how the position of the BV collector frame within the colonies influences BV quantity and honey bee activities (i.e., brood-rearing, bee bread, and honey storage) in addition to the use of the same glass plate to collect BV from three colonies where one hour for each colony. The experiment was carried out from August to December 2022. The bee venom collector frame was placed in two positions: one on the upper top frames of honey bee colonies (method 1), and the other position beside the honey bee frame in the brood chamber between honey and bee bread (method 2). The venom collection is every 15 days for 60 min. Every 12 days, the areas (in inches)2 of bee brood, bee bread, and honey were recorded. The highest quantity of venom collected was 173.33 +/- 1.53 and 250.00 +/- 10.00 mg/colony, while the lowest values were 10 +/- 0.0 and 20 +/- 5 mg for each colony of methods 1 and 2, respectively. The results showed there is a significant difference between methods 1 and 2. Method 2 is given a higher quantity of BV compared to method 1. Also, the study showed no significant differences in the brood-rearing area, the storage of bee bread, and food consumption when comparing treated and control colonies. Furthermore, the study revealed that the method of venom collection significantly influenced the amount of venom obtained. Specifically, the use of a BV collector frame (referred to as method 2), positioned within the colony between the honey and bee bread frames, proved to be a more efficient technique for venom production compared to method 1.},
  publisher = {TAYLOR \& FRANCIS LTD},
