  issn = {0889-504X},
  keywords-plus = {FLOW},
  research-areas = {Engineering},
  web-of-science-categories = {Engineering, Mechanical},
  author-email = {vorreiter@tfd.uni-hannover.de s.fischer@tu-braunschweig.de horst.saathoff@siemens.com r.radespiel@tu-braunschweig.de seume@tfd.uni-hannover.de},
  affiliations = {Leibniz University Hannover; Braunschweig University of Technology; Siemens AG; Siemens Germany},
  orcid-numbers = {Seume, Joerg/0000-0003-2007-7905},
  funding-acknowledgement = {Deutsche Forschungsgemeinschaft (DFG) {[}SE 1023/12-01, SA 1352/1]; Sven Bluemel at the Institute of Turbomachinery; Fluid Dynamics of Leibniz Universitat Hannover},
  funding-text = {This report presents scientific result of a research project, sponsored by the Deutsche Forschungsgemeinschaft (DFG) under Grant Nos. SE 1023/12-01 and SA 1352/1. The authors would like to thank Sven Bluemel at the Institute of Turbomachinery and Fluid Dynamics of Leibniz Universitat Hannover, Junior Professor D. Kozulovic, and Lars Muller at the Institute of Fluid Mechanics of Technische Universitat Braunschweig for their support and patience.},
