@article{2012_li_jashs,
  author = {Li, Cong and Han, Lie-Bao and Zhang, Xunzhong},
  title = {Enhanced Drought Tolerance of Tobacco Overexpressing OjERF Gene Is Associated with Alteration in Proline and Antioxidant Metabolism},
