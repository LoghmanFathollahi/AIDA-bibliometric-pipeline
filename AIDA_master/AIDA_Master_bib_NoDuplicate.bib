  issn = {0232-4393},
  keywords = {ERWINIA-AMYLOVORA; DETECTION METHODS; ISOLATION BY A SEMISELECTIVE MEDIUM; SEROLOGY; AGGLUTINATION ASSAY; ELISA; IMMUNOFLUORESCENCE TECHNIQUE; SENSITIVITY; SPECIFICITY; SURVIVAL},
