@article{2018_langenberg_acp,
  author = {Langenberg, Stefan and Schurath, Ulrich},
  title = {Gas chromatography using ice-coated fused silica columns: study of adsorption of sulfur dioxide on water ice},
  journal = {ATMOSPHERIC CHEMISTRY AND PHYSICS},
  year = {2018},
  volume = {18},
  number = {10},
  pages = {7527-7537},
  month = {MAY 30},
  abstract = {The well established technique of gas chromatography is used to investigate interactions of sulfur dioxide with a crystalline ice film in a fused silica wide bore column. Peak shape analysis of SO2 chromatograms measured in the temperature range 205-265K is applied to extract parameters describing a combination of three processes: (i) physisorption of SO2 at the surface, (ii) dissociative reaction with water and (iii) slow uptake into bulk ice. Process (ii) is described by a dissociative Langmuir isotherm. The pertinent monolayer saturation capacity is found to increase with temperature. The impact of process (iii) on SO2 peak retention time is found to be negligible under our experimental conditions. By analyzing binary chromatograms of hydrophobic n-hexane and hydrophilic acetone, the premelt surface layer is investigated in the temperature range 221-263 K, possibly giving rise to irregular adsorption. Both temperature dependencies fit simple van't Hoff equations as expected for process (i), implying that irregular adsorption of acetone is negligible in the investigated temperature range. Adsorption enthalpies of -45 +/- 5 and -23 +/- 2 kJ mol(-1) are obtained for acetone and n-hexane. The motivation of our study was to assess the vertical displacement of SO2 and acetone in the wake of aircraft by adsorption on ice particles and their subsequent sedimentation. Our results suggest that this transport mechanism is negligible.},
  publisher = {COPERNICUS GESELLSCHAFT MBH},
  address = {BAHNHOFSALLEE 1E, GOTTINGEN, 37081, GERMANY},
  type = {Article},
  language = {English},
  affiliation = {Langenberg, S (Corresponding Author), Univ Bonn, Inst Phys \& Theoret Chem, Bonn, Germany. Langenberg, S (Corresponding Author), Univ Bonn, Klin \& Poliklin Hals Nasen Ohrenheilkunde Chirurg, Bonn, Germany. Langenberg, Stefan, Univ Bonn, Inst Phys \& Theoret Chem, Bonn, Germany. Schurath, Ulrich, Heidelberg Univ, Inst Umweltphys, Heidelberg, Germany. Langenberg, Stefan, Univ Bonn, Klin \& Poliklin Hals Nasen Ohrenheilkunde Chirurg, Bonn, Germany.; University of Bonn; Klinik und Poliklinik für Hals-, Nasen-, Ohrenheilkunde; Heidelberg University},
  doi = {10.5194/acp-18-7527-2018},
  issn = {1680-7316},
  eissn = {1680-7324},
  keywords-plus = {TRACE GASES; SO2; SURFACES; PRESSURE; ACETONE; IONIZATION; SORPTION; ACID},
  research-areas = {Environmental Sciences \& Ecology; Meteorology \& Atmospheric Sciences},
