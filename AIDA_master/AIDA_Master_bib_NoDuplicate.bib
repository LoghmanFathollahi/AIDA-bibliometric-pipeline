@article{2010_orlando_cg,
  author = {Orlando, Andrea and Conte, Aida Maria and Borrini, Daniele and Perinelli, Cristina and Gianelli, Giovanni and Tassi, Franco},
  title = {Experimental investigation of CO2-rich fluids production in a geothermal area: The Mt Amiata (Tuscany, Italy) case study},
  journal = {CHEMICAL GEOLOGY},
  year = {2010},
  volume = {274},
  number = {3-4},
  pages = {177-186},
  month = {JUL 1},
  abstract = {Water rock interaction experiments have been performed to investigate the production of CO2-rich gas in the deep reservoir of the geothermal system of Mt Amiata (Italy) through the interaction between a natural phyllite sample (coming from 1115 m below ground level and considered representative of the deep reservoir) and a coexisting fluid phase. Experiments were conducted with an externally heated pressure vessel, a chamber furnace and a stirred micro-reactor at 300 degrees C and at P up to 35 MPa, using different solid/liquid ratios, and also under nominally anhydrous conditions. Experimental results show that CO2-rich gases containing variable amount of CO, CH4 and other aliphatic and aromatic hydrocarbons were produced by fluid rock interaction. Compositional data of the gas, coupled with solid residua characterization, show that thermal decomposition of magnesian siderite in phyllite is the process responsible for the gas genesis. This process is particularly effective when aqueous solutions interact with phyllite and it may represent the thermometamorphic reaction mainly responsible of the production of CO2-rich gas under hydrothermal conditions similar to those of the main reservoir in the Mt Amiata geothermal area. (C) 2010 Elsevier B.V. All rights reserved.},
  publisher = {ELSEVIER},
  address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
  type = {Article},
  language = {English},
  affiliation = {Orlando, A (Corresponding Author), CNR, Ist Geosci \& Georisorse, UOS Firenze, Via G La Pira 4, I-50121 Florence, Italy. Orlando, Andrea, CNR, Ist Geosci \& Georisorse, UOS Firenze, I-50121 Florence, Italy. Conte, Aida Maria, CNR, Ist Geosci \& Georisorse, UOS Roma, I-00185 Rome, Italy. Borrini, Daniele; Tassi, Franco, Univ Florence, Dipartimento Sci Terra, I-50121 Florence, Italy. Perinelli, Cristina, Univ Pisa, Dipartimento Sci Terra, I-56126 Pisa, Italy. Gianelli, Giovanni, CNR, Ist Geosci \& Georisorse, I-56124 Pisa, Italy.},
  doi = {10.1016/j.chemgeo.2010.04.005},
  issn = {0009-2541},
  eissn = {1872-6836},
  keywords = {Fluid-rock interaction experiments; Mt Amiata geothermal area; CO2-rich fluids; Decarbonation; Siderite},
  keywords-plus = {OXYGEN-ISOTOPE FRACTIONATION; ISUA SUPRACRUSTAL BELT; REGIONAL AQUIFERS; SOUTHERN TUSCANY; CARBON BALANCE; CO2 EMISSION; DEEP CO2; SIDERITE; HYDROCARBONS; CONSTRAINTS},
  research-areas = {Geochemistry \& Geophysics},
  web-of-science-categories = {Geochemistry \& Geophysics},
  author-email = {orlando@igg.cnr.it},
  affiliations = {Consiglio Nazionale delle Ricerche (CNR); Istituto di Geoscienze e Georisorse (IGG-CNR); Consiglio Nazionale delle Ricerche (CNR); Istituto di Geoscienze e Georisorse (IGG-CNR); University of Florence; University of Pisa; Consiglio Nazionale delle Ricerche (CNR); Istituto di Geoscienze e Georisorse (IGG-CNR)},
  researcherid-numbers = {Perinelli, Cristina/AAU-9733-2020 Tassi, Franco/G-7857-2012 ORLANDO, ANDREA/AAY-4980-2020},
  orcid-numbers = {Borrini, Daniele/0009-0005-2900-1837 Perinelli, Cristina/0000-0002-2308-461X CONTE, AIDAMARIA/0000-0001-6733-6113 Yakisik, Onat/0009-0007-8578-6063 Tassi, Franco/0000-0002-3319-4257 ORLANDO, ANDREA/0000-0003-3540-3232},
