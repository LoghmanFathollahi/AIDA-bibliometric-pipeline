  doi = {10.1109/TNS.2017.2689244},
  issn = {0018-9499},
  eissn = {1558-1578},
  keywords = {GridPix; InGrid; international large detector (ILD); international linear collider (ILC); pixel-time projection chamber (TPC); Timepix; TPC},
  keywords-plus = {MICROMEGAS; TIMEPIX; CHIP; GEM},
  research-areas = {Engineering; Nuclear Science \& Technology},
  web-of-science-categories = {Engineering, Electrical \& Electronic; Nuclear Science \& Technology},
  author-email = {michael.lupberger@cern.ch},
  affiliations = {University of Bonn; European Organization for Nuclear Research (CERN)},
  orcid-numbers = {Kaminski, Jochen/0000-0001-5979-6996},
