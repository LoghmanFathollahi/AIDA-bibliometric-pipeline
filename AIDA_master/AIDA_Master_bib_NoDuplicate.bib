@article{2005_stockel_jpca,
  author = {Stöckel, P and Weidinger, IM and Baumgärtel, H and Leisner, T},
  title = {Rates of homogeneous ice nucleation in levitated H2O and D2O droplets},
  journal = {JOURNAL OF PHYSICAL CHEMISTRY A},
  year = {2005},
  volume = {109},
  number = {11},
  pages = {2540-2546},
  month = {MAR 24},
  abstract = {Rates of homogeneous nucleation of H2O droplets in a temperature range from 236.37 to 237.91 K and of D2O droplets from 241.34 to 242.33 K were measured. The single microdroplets consisted of pure H2O or D2O and were levitated in an electrodynamic balance. In comparison to H2O, D2O shows a stronger tendency to nucleate. Over the investigated temperature interval, D2O droplets need to be supercooled less by 1.1 K compared to H2O droplets in order to arrive at the same nucleation rate. This is in good agreement with the higher degree of intermolecular association in liquid D2O , a fact which has been well established previously both from theory and experimental studies.},
  publisher = {AMER CHEMICAL SOC},
  address = {1155 16TH ST, NW, WASHINGTON, DC 20036 USA},
