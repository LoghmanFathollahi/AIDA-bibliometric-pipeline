  issn = {2169-897X},
  eissn = {2169-8996},
  keywords-plus = {AMMONIUM-SULFATE PARTICLES; LIQUID PHASE-SEPARATION; OXALIC-ACID; INORGANIC ELECTROLYTES; THERMODYNAMIC MODELS; DICARBOXYLIC-ACIDS; RELATIVE-HUMIDITY; AQUEOUS-SOLUTIONS; SOLUTION DROPLETS; LIGHT-SCATTERING},
  research-areas = {Meteorology \& Atmospheric Sciences},
