@article{2005_benz_jppac,
  author = {Benz, S and Megahed, K and Möhler, O and Saathoff, H and Wagner, R and Schurath, U},
  title = {T-dependent rate measurements of homogeneous ice nucleation in cloud droplets using a large atmospheric simulation chamber},
