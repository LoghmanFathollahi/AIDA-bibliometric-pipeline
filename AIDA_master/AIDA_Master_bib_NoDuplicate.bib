@article{2025_ouederni_ijper,
  author = {Ouederni, Ahmed Ridha El and Omrani, Rania and Taktouk, Sonia and Ouederni, Yasmine El and Ouederni, Nour El and Katar, Aida},
  title = {Novel Solar Micro Dryer for Aromatic and Medicinal Plants},
  journal = {INDIAN JOURNAL OF PHARMACEUTICAL EDUCATION AND RESEARCH},
  year = {2025},
  volume = {59},
  number = {3, S},
  month = {JUL-SEP},
  abstract = {Background: This paper focuses on an experimental investigation of an indirect solar dryer, specifically designed for drying aromatic and medicinal plants. Objectives: The purpose of this study is to utilize solar energy as a sustainable and efficient source of heat for the drying process, ensuring high-quality dried products. Materials and Methods: Our project aimed to study, design, implement, and experimentally evaluate an indirect solar micro-dryer. The study involves conducting experiments using different types of aromatic and medicinal plants, analyzing the drying kinetics, and assessing the quality of the dried products. Results: The results demonstrate the effectiveness of the micro-solar dryer in achieving rapid and efficient drying while preserving the essential properties of the plants. Conclusion: The findings provide valuable insights into the potential application of solar drying technology for aromatic and medicinal plant processing, contributing to the development of sustainable and environmentally friendly drying methods in the agroindustry.},
