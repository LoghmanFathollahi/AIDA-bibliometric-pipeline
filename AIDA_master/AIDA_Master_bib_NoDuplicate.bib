  keywords-plus = {CAMPANIAN IGNIMBRITE ERUPTION; TIME-DEPENDENT GEOCHEMISTRY; PHASE-EQUILIBRIA; ALBAN HILLS; EVOLUTION; CONSTRAINTS; SARDINIA; ORIGIN; ROCKS; CLINOPYROXENE},
  research-areas = {Geochemistry \& Geophysics},
  web-of-science-categories = {Geochemistry \& Geophysics},
  author-email = {cristina.perinelli@uniroma1.it},
  affiliations = {Sapienza University Rome; University of Sassari; Consiglio Nazionale delle Ricerche (CNR); Istituto di Geologia Ambientale e Geoingegneria (IGAG-CNR); University of Siena},
  researcherid-numbers = {Perinelli, Cristina/AAU-9733-2020 Sottili, Gianluca/ABD-5074-2020 Cardello, Giovanni Luca/R-6621-2016},
  orcid-numbers = {Perinelli, Cristina/0000-0002-2308-461X Sottili, Gianluca/0000-0001-7977-8330 Monaco, Lorenzo/0000-0002-6555-0842 Cardello, Giovanni Luca/0000-0003-0521-7949},
  funding-acknowledgement = {Sapienza-Universita di Roma; Italian Ministry of Education, University and Research (MIUR) {[}20177TKBXZ\_003]},
  funding-text = {This research was carried out within the projects: Ateneo 2021-Medi `Ventotene: the missing link in the Quaternary potassic magmatism of central Italy', supported by Sapienza-Universita di Roma (D.M. Palladino, coordinator), `FUcino Tephrochronology Unites Quaternary REcords (FUTURE)', supported by the Italian Ministry of Education, University and Research (MIUR, grant PRIN No. 20177TKBXZ\_003; G. Zanchetta, coordinator) and PNRR PE3: RETURN projects-multi-Risk sciEnce for resilicnT commUnities undeR a changiNg climate area tematica 3 `Rischi ambientali, naturali e antropici' Spoke 3, the Italian Ministry of Education, University and Research (MIUR). We express our gratitude to Antonio Romano, the director of the Area Marina Protetta Isole di Ventotene e Santo Stefano, the municipal administration of Ventotene for their invaluable logistical support and the assistance provided by Tiziana Marrone and Patrizia Mattarelli during the kayak exploration. We also extend our gratitude to Claudia Romano, Alessandro Vona, and Danilo Di Genova for providing access to the Raman facilities. Finally, this paper greatly benefited from the constructive reviews by the editor Mary Reid and three anonymous reviewers.},
