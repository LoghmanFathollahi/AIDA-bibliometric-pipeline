  cited-references = {Chatzimavroudis GP, 1997, MAGNET RESON MED, V37, P545, DOI 10.1002/mrm.1910370412. CRAFT CH, 1984, AM J CARDIOL, V53, P1593. DULCE MC, 1992, RADIOLOGY, V185, P235, DOI 10.1148/radiology.185.1.1523315. KIM WY, 1994, J AM COLL CARDIOL, V24, P532, DOI 10.1016/0735-1097(94)90314-X. OMOTO R, 1984, JPN HEART J, V25, P325. PU M, 1995, J AM SOC ECHOCARDIOG, V8, P393. REIMOLD SC, 1991, J AM COLL CARDIOL, V18, P761, DOI 10.1016/0735-1097(91)90800-O. SAHN DJ, 1988, J AM COLL CARDIOL, V12, P1354, DOI 10.1016/0735-1097(88)92621-6. SHAKUDO M, 1994, CIRCULATION, V90, P495. SHAKUDO M, 1995, J AM SOC ECHOCARDIOG, V8, P394. SHATTUCK DP, 1984, J ACOUST SOC AM, V75, P1273, DOI 10.1121/1.390734. Shiota T, 1997, J AM COLL CARDIOL, V30, P834, DOI 10.1016/S0735-1097(97)00210-6. Shiota T, 1996, CIRCULATION, V93, P594, DOI 10.1161/01.CIR.93.3.594. SUN JP, 1995, CIRCULATION, V92, P15. Tsujino H, 1995, J Am Soc Echocardiogr, V8, P621, DOI 10.1016/S0894-7317(05)80375-X. WALKER PG, 1995, CIRCULATION S1, V92, P193. YOGANATHAN AP, 1988, J AM COLL CARDIOL, V12, P1344, DOI 10.1016/0735-1097(88)92620-4.},
