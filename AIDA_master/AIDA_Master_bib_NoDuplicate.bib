  keywords = {Single scattering; Gaussian beam; PHIPS; Non-spherical particle; Phase function measurement; Ice crystals; Optics; Scattering; Troposphere; Ray tracing (physics); Phase (matter); Physics; Computational physics},
  keywords-plus = {SCATTERING PROPERTIES; SIMULATION},
