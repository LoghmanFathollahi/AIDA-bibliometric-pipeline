@article{1987_naumann_zm,
  author = {NAUMANN, K and SCHMIDT, HB},
  title = {SCANNING ELECTRON-MICROSCOPY STUDIES ON EARLY STATES OF POTATO SOFT ROTTING DISEASE},
  journal = {ZENTRALBLATT FUR MIKROBIOLOGIE},
  year = {1987},
  volume = {142},
  number = {1},
  pages = {49-61},
  abstract = {By scanning electron microscopic observation the effects of an inoculation of potato parenchyma cells by Erwinia carotovora subsp. atroseptica were studied. Immediately after inoculation the bacterial cells are irregularly distributed on the surface of the parenchyma cells. However, already 4 h p.i. the division of the bacteria is starting and small microcolonies are developing, 8 h p.i. a loose film of bacteria could be observed upon the parenchyma cells. 14-16 h later a thick more layer-cover of Erwinia cells has established itself. As a result of secreting pectolytic enzymes the development of a slime matrix could be observed, wherein the Erwinia cells are embedded; this slime layer contains many oval holes presumably produced by bacteria cells as lysis zones. These structures were to detect firstly 24 h p.i. To the same time as a second effect of the enzyme attack a loose network of long filaments were to find. It is suggested, that it could be cellulose microfibrils solved out of pectin matrix, which represents the main component of the primary wall of the plant cells.},
  publisher = {GUSTAV FISCHER VERLAG JENA},
  address = {VILLENGANG 2, D-07745 JENA, GERMANY},
  type = {Article},
  language = {German},
