@article{2013_hoffmann_fd,
  author = {Hoffmann, Nadine and Duft, Denis and Kiselev, Alexei and Leisner, Thomas},
  title = {Contact freezing efficiency of mineral dust aerosols studied in an electrodynamic balance: quantitative size and temperature dependence for illite particles},
  journal = {FARADAY DISCUSSIONS},
  year = {2013},
  volume = {165},
  pages = {383-390},
  abstract = {Contact freezing has long been discussed as a candidate for cloud ice formation at temperatures warmer than about -25 degrees C, but until now the molecular mechanism underlying this process has remained obscure and little quantitative information about the size and temperature dependent contact freezing properties of the various aerosol species is available. In this contribution, we present the first quantitative measurements of the freezing probability of a supercooled droplet upon a single contact with a size selected illite mineral particle. It is found that this probability is a strong function of temperature and aerosol particle size. For the particles investigated and on the minute time scale of the experiment, contact freezing indeed dominates immersion freezing for all temperatures.},
  publisher = {ROYAL SOC CHEMISTRY},
  address = {THOMAS GRAHAM HOUSE, SCIENCE PARK, MILTON RD, CAMBRIDGE CB4 0WF, CAMBS, ENGLAND},
  type = {Article},
