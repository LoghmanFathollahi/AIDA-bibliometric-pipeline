  funding-acknowledgement = {Ministry of Education, Culture, Sports, Science and Technology of the Japanese Government under the program of Special Coordination Funds for Promoting Science and Technology, ``Japanese Cloud Seeding Experiments for Precipitation Augmentation (JCSEPA){''}; Grants-in-Aid for Scientific Research {[}23244095] Funding Source: KAKEN},
