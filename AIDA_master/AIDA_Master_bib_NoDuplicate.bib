@article{2010_kosina_fitoterapia,
  author = {Kosina, Pavel and Gregorova, Jana and Gruz, Jiri and Vacek, Jan and Kolar, Milan and Vogel, Mathias and Roos, Werner and Naumann, Kathrin and Simanek, Vilim and Ulrichova, Jitka},
  title = {Phytochemical and antimicrobial characterization of Macleaya cordata herb},
  journal = {FITOTERAPIA},
  year = {2010},
  volume = {81},
  number = {8},
  pages = {1006-1012},
  month = {DEC},
  abstract = {Macleaya cordata (plume poppy) is a source of bioactive compounds, mainly isoquinoline alkaloids which are used in phytopreparations with anti-inflammatory and antimicrobial activities. In this study, the alkaloids sanguinarine, chelerythrine, their dihydro derivatives, protopine and allocryptopine and phenolics, gallic, protocatechuic, p-hydroxybenzoic, m-hydroxybenzoic, gentisic, p-coumaric, caffeic, ferulic and sinapic acids were determined in extracts prepared from M. cordata aerial part, seeds, and seed capsules using HPLC with UV detection and/or LC/MS with electrospray ionization. The highest content of sanguinarine and chelerythrine was found in capsules. Protopine and allocryptopine were major alkaloids in leaves including footstalks. The seed oil contained dihydrosanguinarine, dihydrochelerythrine and twelve fatty acids of which linoleic, oleic, palmitic and stearic acids predominated. In addition, sanguinarine reductase, a key enzyme in sanguinarine/dihydrosanguinarine equilibrium in plants, was found for the first time, in the soluble proteins of leaves. Finally, extracts were tested for antimicrobial activity using the microdilution method on standard reference bacterial strains. (C) 2010 Elsevier B.V. All rights reserved.},
  publisher = {ELSEVIER SCIENCE BV},
  address = {PO BOX 211, 1000 AE AMSTERDAM, NETHERLANDS},
  type = {Article},
  language = {English},
  affiliation = {Kosina, P (Corresponding Author), Palacky Univ, Dept Med Chem \& Biochem, Fac Med \& Dent, Hnevotinska 3, Olomouc 77515, Czech Republic. Kosina, Pavel; Vacek, Jan; Simanek, Vilim; Ulrichova, Jitka, Palacky Univ, Dept Med Chem \& Biochem, Fac Med \& Dent, Olomouc 77515, Czech Republic. Gregorova, Jana, Masaryk Univ, Dept Biochem, Fac Med, Brno 62500, Czech Republic. Gruz, Jiri, Palacky Univ, Lab Growth Regulators, Olomouc 78371, Czech Republic. Gruz, Jiri, AS CR, Inst Expt Bot, Olomouc 78371, Czech Republic. Kolar, Milan, Palacky Univ, Dept Microbiol, Fac Med \& Dent, Olomouc 77515, Czech Republic. Vogel, Mathias; Roos, Werner, Univ Halle Wittenberg, Inst Pharmaceut Biol \& Pharmacol, Dept Mol Cell Biol, D-06120 Halle, Saale, Germany. Naumann, Kathrin, Phytobiot Futterzusatzstoffe GmbH, D-65343 Eltville, Germany.},
  doi = {10.1016/j.fitote.2010.06.020},
  issn = {0367-326X},
