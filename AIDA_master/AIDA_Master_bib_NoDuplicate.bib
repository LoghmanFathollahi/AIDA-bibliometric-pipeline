@article{2020_liang_jpcc,
  author = {Liang, Haoran and Moehler, Ottmar and Griffiths, Steven and Zou, Linda},
  title = {Enhanced Ice Nucleation and Growth by Porous Composite of RGO and Hydrophilic Silica Nanoparticles},
