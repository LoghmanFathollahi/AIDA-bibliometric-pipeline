@article{2021_he_science,
  author = {He, Xu-Cheng and Tham, Yee Jun and Dada, Lubna and Wang, Mingyi and Finkenzeller, Henning and Stolzenburg, Dominik and Iyer, Siddharth and Simon, Mario and Kuerten, Andreas and Shen, Jiali and Roerup, Birte and Rissanen, Matti and Schobesberger, Siegfried and Baalbaki, Rima and Wang, Dongyu S. and Koenig, Theodore K. and Jokinen, Tuija and Sarnela, Nina and Beck, Lisa J. and Almeida, Joao and Amanatidis, Stavros and Amorim, Antonio and Ataei, Farnoush and Baccarini, Andrea and Bertozzi, Barbara and Bianchi, Federico and Brilke, Sophia and Caudillo, Lucia and Chen, Dexian and Chiu, Randall and Chu, Biwu and Dias, Antonio and Ding, Aijun and Dommen, Josef and Duplissy, Jonathan and El Haddad, Imad and Carracedo, Loic Gonzalez and Granzin, Manuel and Hansel, Armin and Heinritzi, Martin and Hofbauer, Victoria and Junninen, Heikki and Kangasluoma, Juha and Kemppainen, Deniz and Kim, Changhyuk and Kong, Weimeng and Krechmer, Jordan E. and Kvashin, Aleksander and Laitinen, Totti and Lamkaddam, Houssni and Lee, Chuan Ping and Lehtipalo, Katrianne and Leiminger, Markus and Li, Zijun and Makhmutov, Vladimir and Manninen, Hanna E. and Marie, Guillaume and Marten, Ruby and Mathot, Serge and Mauldin, Roy L. and Mentler, Bernhard and Moehler, Ottmar and Mueller, Tatjana and Nie, Wei and Onnela, Antti and Petaja, Tuukka and Pfeifer, Joschka and Philippov, Maxim and Ranjithkumar, Ananth and Saiz-Lopez, Alfonso and Salma, Imre and Scholz, Wiebke and Schuchmann, Simone and Schulze, Benjamin and Steiner, Gerhard and Stozhkov, Yuri and Tauber, Christian and Tome, Antonio and Thakur, Roseline C. and Vaisanen, Olli and Vazquez-Pufleau, Miguel and Wagner, Andrea C. and Wang, Yonghong and Weber, Stefan K. and Winkler, Paul M. and Wu, Yusheng and Xiao, Mao and Yan, Chao and Ye, Qing and Ylisirnio, Arttu and Zauner-Wieczorek, Marcel and Zha, Qiaozhi and Zhou, Putian and Flagan, Richard C. and Curtius, Joachim and Baltensperger, Urs and Kulmala, Markku and Kerminen, Veli-Matti and Kurten, Theo and Donahue, Neil M. and Volkamer, Rainer and Kirkby, Jasper and Worsnop, Douglas R. and Sipila, Mikko},
  title = {Role of iodine oxoacids in atmospheric aerosol nucleation},
  journal = {SCIENCE},
  year = {2021},
  volume = {371},
  number = {6529, SI},
  pages = {589+},
  month = {FEB 5},
  abstract = {Iodic acid (HIO3) is known to form aerosol particles in coastal marine regions, but predicted nucleation and growth rates are lacking. Using the CERN CLOUD (Cosmics Leaving Outdoor Droplets) chamber, we find that the nucleation rates of HIO3 particles are rapid, even exceeding sulfuric acid-ammonia rates under similar conditions. We also find that ion-induced nucleation involves IO3- and the sequential addition of HIO3 and that it proceeds at the kinetic limit below +10 degrees C. In contrast, neutral nucleation involves the repeated sequential addition of iodous acid (HIO2) followed by HIO3, showing that HIO2 plays a key stabilizing role. Freshly formed particles are composed almost entirely of HIO3, which drives rapid particle growth at the kinetic limit. Our measurements indicate that iodine oxoacid particle formation can compete with sulfuric acid in pristine regions of the atmosphere.},
  publisher = {AMER ASSOC ADVANCEMENT SCIENCE},
  address = {1200 NEW YORK AVE, NW, WASHINGTON, DC 20005 USA},
