@article{2003_naumann_zeitgeschich,
  author = {Naumann, K},
  title = {``Good Nazis{''} for the Bundeswehr? Former POWs in the Soviet Union as generals and officers in the army of the Federal Republic of Germany},
  journal = {ZEITGESCHICHTE},
  year = {2003},
  volume = {30},
  number = {4},
  pages = {211-224},
  month = {JUL-AUG},
  note = {26th Annual Conference of the German-Studies-Association (GSA), SAN DIEGO, CALIFORNIA, OCT, 2002},
  organization = {German Studies Assoc},
  abstract = {In the early period of the Bundeswehr, the army of the German Federal Republic faced the problem of creating a new ``army in a democracy{''} with the old leaders of the Wehrmacht. A special dilemma was linked to those high-ranking officers, such as the later General Inspector of the Bundeswehr Friedrich Foertsch, belonging to the small group of POWs in the Soviet Union who were not released until 1955. They had spent ten years or more in POW camps, had not experienced the post-war developments in the West first-hand and had been unable to work in civilian jobs after the war. Re-integrating them into the Bundeswehr proved difficult, since they had failed to dissociate themselves from Germany's Nazi past.},
