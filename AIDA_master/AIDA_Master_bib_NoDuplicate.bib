@article{1980_bahe_ae,
  author = {BAHE, FC and SCHURATH, U and BECKER, KH},
  title = {THE FREQUENCY OF NO2 PHOTOLYSIS AT GROUND-LEVEL, AS RECORDED BY A CONTINUOUS ACTINOMETER},
  journal = {ATMOSPHERIC ENVIRONMENT},
  year = {1980},
  volume = {14},
  number = {6},
  pages = {711-718},
  abstract = {The NO2 photolysis frequency j(NO2) was recorded over the period 18 May 1975-31 March 1977. Half-hourly integrals P30 of j(NO2) and G30 of the global radiation G on a flat horizontal surface were obtained between 7 Nov. 1975 and 18 July 1976. The ratio j(NO2)/G depended on the solar zenith angle on clear days and on cloud cover. A plot of P30, vs. G30, including the data pairs for all seasons and weather conditions, does not show significant curvature. The linear regression line through 5053 pairs of half hourly averages is given by j(NO2) = 0.008 + 0.371G, where the photolysis frequency is in units of (min-1) and G in (cal cm-2 min-1). The equation can be used to obtain estimates of j(NO2) when the intensity G of the global radiation is known. The confidence interval of the estimate should be read directly from the spread of data pairs on the graph. The results are compared with other experimental and theoretical work.},
