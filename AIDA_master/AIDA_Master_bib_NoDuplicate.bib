@article{1992_naumann_icb,
  author = {NAUMANN, KM and JONES, GL and SAUL, A and SMITH, R},
  title = {PARASITE-INDUCED CHANGES TO LOCALIZED ERYTHROCYTE-MEMBRANE DEFORMABILITY IN PLASMODIUM-FALCIPARUM CULTURES},
