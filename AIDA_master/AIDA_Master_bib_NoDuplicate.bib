  pages = {3129-3137},
  month = {SEP},
  abstract = {The well-known technique of gas chromatography was used to determine solubilities and liquid-phase diffusion coefficients of trace gases in a thin sulfuric acid film deposited in a fused silica column. Solubilities of SO2, NO2, and N2O4 and the diffusion coefficient of SO2 were measured in the temperature range 203-243 K using sulfuric acid concentrations in the range of 39-83 wt\%. The results suggest that sulfuric acid aerosol particles are not a physical sink for these trace gases. (C) 1998 Elsevier Science Ltd. All rights reserved.},
