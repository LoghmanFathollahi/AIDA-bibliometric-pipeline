@article{2023_gao_est,
  author = {Gao, Linyu and Buchholz, Angela and Li, Zijun and Song, Junwei and Vallon, Magdalena and Jiang, Feng and Mohler, Ottmar and Leisner, Thomas and Saathoff, Harald},
  title = {Volatility of Secondary Organic Aerosol from β-Caryophyllene Ozonolysis over a Wide Tropospheric Temperature Range},
