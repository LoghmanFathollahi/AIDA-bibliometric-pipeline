@article{2026_hamel_acp_b,
  author = {Hamel, Adrian and del Guasta, Massimo and Schmitt, Carl and Genthon, Christophe and Jarvinen, Emma and Schnaiter, Martin},
  title = {Unique microphysical properties of small boundary layer ice particles under pristine conditions on Dome C, Antarctica},
  journal = {ATMOSPHERIC CHEMISTRY AND PHYSICS},
  year = {2026},
  volume = {26},
  number = {2},
  pages = {1211-1228},
  month = {JAN 26},
  abstract = {The Antarctic plateau, one of the coldest and cleanest regions of our planet, experiences almost exclusively frozen precipitation. Understanding the microphysical properties of inland Antarctic boundary layer ice particles with sizes below a few hundred micrometers is essential to improve atmospheric models and accurately validate remote sensing data for this region. Currently, only a small number of in situ atmospheric measurements exist for particle sizes smaller than 100 mu m on the Antarctic plateau, performed over short measurement times. We present the first multi-week study of optical in situ measurements of boundary layer ice particle size, shape and morphological complexity for sizes down to 11 mu m with a temporal resolution in the order of minutes, including a multi-day ice fog event. Classifying ice fog events with a lidar system, we found mean particle sizes smaller than 11 mu m for ice fog events and of about 70 mu m for cirrus precipitation and diamond dust events. The mean particle concentration of the ice fog at Dome C (3.9 L-1) is found to be lower than in parametrisations of Arctic ice fog and lower than the concentration of anthropogenically influenced urban ice fog measured at Fairbanks, Alaska during a three-year study with the same instrument (90 L-1). Moreover, ice fog particles at Dome C are found to be more pristine than at Fairbanks. Our findings show that Antarctic boundary layer ice particles may need to be parametrised differently than their Arctic counterparts due to distinct conditions on the Antarctic plateau.},
  publisher = {COPERNICUS GESELLSCHAFT MBH},
  address = {BAHNHOFSALLEE 1E, GOTTINGEN, 37081, GERMANY},
  type = {Article},
  language = {English},
  affiliation = {Hamel, A (Corresponding Author), Karlsruhe Inst Technol, Inst Meteorol \& Climate Res Atmospher Aerosol Res, Karlsruhe, Germany. Schnaiter, M (Corresponding Author), Univ Wuppertal, Inst Atmospher \& Environm Res, Wuppertal, Germany. Schnaiter, M (Corresponding Author), SchnaiTEC GmbH, Wuppertal, Germany. Hamel, Adrian, Karlsruhe Inst Technol, Inst Meteorol \& Climate Res Atmospher Aerosol Res, Karlsruhe, Germany. del Guasta, Massimo, Ist Nazl Ottica CNR, I-50019 Sesto Fiorentino, Firenze, Italy. Schmitt, Carl, Univ Alaska Fairbanks, Fairbanks, AK USA. Genthon, Christophe, Sorbonne Univ, Ecole Normale Super, PSL Res, Lab Meteorol Dynam,IPSL,CNRS, Paris, France. Jarvinen, Emma; Schnaiter, Martin, Univ Wuppertal, Inst Atmospher \& Environm Res, Wuppertal, Germany. Schnaiter, Martin, SchnaiTEC GmbH, Wuppertal, Germany.; Karlsruhe Institute of Technology; National Institute of Optics; University of Alaska Fairbanks; Centre National de la Recherche Scientifique; Sorbonne Université; Laboratoire de Météorologie Dynamique; University of Wuppertal},
  doi = {10.5194/acp-26-1211-2026},
  issn = {1680-7316},
  eissn = {1680-7324},
  keywords-plus = {ARCTIC DIAMOND DUST; MIXED-PHASE CLOUDS; OPTICAL-PROPERTIES; SUPERCOOLED WATER; THIN STRATUS; AEROSOL; FOG; PRECIPITATION; CRYSTALS; SURFACE},
  research-areas = {Environmental Sciences \& Ecology; Meteorology \& Atmospheric Sciences},
  web-of-science-categories = {Environmental Sciences; Meteorology \& Atmospheric Sciences},
  author-email = {adrian.hamel@kit.edu schnaiter@uni-wuppertal.de},
  affiliations = {Helmholtz Association; Karlsruhe Institute of Technology; Consiglio Nazionale delle Ricerche (CNR); Istituto Nazionale di Ottica (INO-CNR); University of Alaska System; University of Alaska Fairbanks; Institut Polytechnique de Paris; Ecole Polytechnique; Universite PSL; Ecole Normale Superieure (ENS); Sorbonne Universite; Centre National de la Recherche Scientifique (CNRS); University of Wuppertal},
