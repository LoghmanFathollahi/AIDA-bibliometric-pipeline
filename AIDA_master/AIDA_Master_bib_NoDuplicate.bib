  author = {NAUMANN, K and WINSTON, ML and SLESSOR, KN and SMIRLE, MJ},
  title = {SYNTHETIC HONEY-BEE (HYMENOPTERA, APIDAE) QUEEN MANDIBULAR GLAND PHEROMONE APPLICATIONS AFFECT PEAR AND SWEET CHERRY POLLINATION},
