@article{2007_feichter_cuz,
  author = {Feichter, Johann and Schurath, Ulrich and Zellner, Reinhard},
  title = {Air chemistry and climate},
  journal = {CHEMIE IN UNSERER ZEIT},
  year = {2007},
  volume = {41},
  number = {3},
  pages = {138-150},
  month = {JUN},
  abstract = {In the public perception air pollution is a priority issue only in urban and industrialized areas, whereas climate change is recognized as a global problem. However, air pollution is largely driven by the some emissions as climate change (i.e. traffic, energy sector, agriculture: e.g., carbon dioxide, methane, carbon monoxide, hydrocarbons, sulfur dioxide and nitrogen oxides emissions). Emission control for environment and climate protection thus requires to reduce emissions from the some sources. In addition, weather and climate affects the cycling of atmospheric trace substances and the emissions of trace species from biogenic sources as for instance the marine biosphere or vegetation. Climate is changing, and will continue to change. As climate changes, urban and regional air quality will change as well. Development of strategies for protection of climate and environment requires better integration of the scientific communities dealing with climate and air-quality issues.},
