  author = {Gao, Kunfeng and Vogel, Franziska and Foskinis, Romanos and Vratolis, Stergios and Gini, Maria I. and Granakis, Konstantinos and Billault-Roux, Anne-Claire and Georgakaki, Paraskevi and Zografou, Olga and Fetfatzis, Prodromos and Berne, Alexis and Papayannis, Alexandros and Eleftheridadis, Konstantinos and Moehler, Ottmar and Nenes, Athanasios},
  title = {Biological and dust aerosols as sources of ice-nucleating particles in the eastern Mediterranean: source apportionment, atmospheric processing and parameterization},
  journal = {ATMOSPHERIC CHEMISTRY AND PHYSICS},
  year = {2024},
  volume = {24},
