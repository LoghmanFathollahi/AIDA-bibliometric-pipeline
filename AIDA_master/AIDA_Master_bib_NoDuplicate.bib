  affiliations = {Helmholtz Association; Karlsruhe Institute of Technology; Helmholtz Association; Karlsruhe Institute of Technology; Ruprecht Karls University Heidelberg},
  researcherid-numbers = {Leisner, Thomas/A-2391-2013 /N-6245-2019 Kiselev, Alexei/A-3036-2013 Michaelides, Angelos/KAM-5097-2024},
