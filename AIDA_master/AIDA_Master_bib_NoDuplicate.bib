  author = {MOHLER, O and REINER, T and ARNOLD, F},
  title = {THE FORMATION OF SO5- BY GAS-PHASE ION-MOLECULE REACTIONS},
  journal = {JOURNAL OF CHEMICAL PHYSICS},
