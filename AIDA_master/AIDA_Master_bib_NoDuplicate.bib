@article{2024_brasseur_acp,
  author = {Brasseur, Zoe and Schneider, Julia and Lampilahti, Janne and Vakkari, Ville and Sinclair, Victoria A. and Williamson, Christina J. and Xavier, Carlton and Moisseev, Dmitri and Hartmann, Markus and Poutanen, Pyry and Lampimaki, Markus and Kulmala, Markku and Petaja, Tuukka and Lehtipalo, Katrianne and Thomson, Erik S. and Hohler, Kristina and Mohler, Ottmar and Duplissy, Jonathan},
  title = {Vertical distribution of ice nucleating particles over the boreal forest of Hyytiälä, Finland},
  journal = {ATMOSPHERIC CHEMISTRY AND PHYSICS},
  year = {2024},
  volume = {24},
  number = {19},
  pages = {11305-11332},
  month = {OCT 10},
  abstract = {Ice nucleating particles (INPs) play a crucial role in initiating ice crystal formation in clouds, influencing the dynamics and optical properties of clouds and their impacts on precipitation and the climate system. Despite their importance, there is limited knowledge about the vertical distribution of INPs. This study focuses on aircraft measurements conducted during spring 2018 above the boreal forest of Hyyti \& auml;l \& auml;, Finland. Similarities between INP concentrations, activated fractions, particle concentrations, and size distributions observed at ground level and in the boundary layer aloft indicate that surface particles and INPs are efficiently transported and mixed within the boundary layer. INP concentrations observed in the boundary layer are best predicted by a parameterization describing near-surface INP concentrations driven by the abundance of biogenic aerosol in the Finnish boreal forest, suggesting that biogenic INPs are dominant in the boundary layer above the same environment. Most of the INP concentrations and activated fractions observed in the free troposphere are notably lower than in the boundary layer, and the distinct particle size distributions suggest that different aerosol populations, likely resulting from long-range transport, are present in the free troposphere. However, we show one case where higher INP concentrations are observed in the free troposphere and where a homogeneous particle population exists from the surface to the free troposphere. This indicates that surface particles and INPs from the boreal forest can occasionally reach the free troposphere, which is particularly important as the INPs in the free troposphere can further travel horizontally and/or vertically and impact cloud formation.},
  publisher = {COPERNICUS GESELLSCHAFT MBH},
  address = {BAHNHOFSALLEE 1E, GOTTINGEN, 37081, GERMANY},
  type = {Article},
  language = {English},
  affiliation = {Brasseur, Z (Corresponding Author), Univ Helsinki, Inst Atmospher \& Earth Syst Res Phys, Fac Sci, Helsinki, Finland. Brasseur, Zoe; Lampilahti, Janne; Sinclair, Victoria A.; Williamson, Christina J.; Moisseev, Dmitri; Poutanen, Pyry; Lampimaki, Markus; Kulmala, Markku; Petaja, Tuukka; Lehtipalo, Katrianne; Duplissy, Jonathan, Univ Helsinki, Inst Atmospher \& Earth Syst Res Phys, Fac Sci, Helsinki, Finland. Schneider, Julia; Hohler, Kristina; Mohler, Ottmar, Karlsruhe Inst Technol, Inst Meteorol \& Climate Res, Karlsruhe, Germany. Vakkari, Ville; Williamson, Christina J.; Moisseev, Dmitri; Lehtipalo, Katrianne, Finnish Meteorol Inst, Helsinki, Finland. Vakkari, Ville, North West Univ, Atmospher Chem Res Grp, Chem Resource Beneficiat, Potchefstroom, South Africa. Xavier, Carlton, Lund Univ, Dept Phys, Lund, Sweden. Xavier, Carlton, Swedish Meteorol \& Hydrol Inst SMHI, Norrkoping, Sweden. Hartmann, Markus, Leibniz Inst Tropospher Res, Atmospher Microphys, Leipzig, Germany. Thomson, Erik S., Univ Gothenburg, Dept Chem \& Mol Biol, Atmospher Sci, Gothenburg, Sweden.; University of Helsinki; Karlsruhe Institute of Technology; Finnish Meteorological Institute; North-West University; Swedish Meteorological and Hydrological Institute; Lund University; Leibniz Institute for Tropospheric Research; University of Gothenburg},
  doi = {10.5194/acp-24-11305-2024},
  issn = {1680-7316},
  eissn = {1680-7324},
  keywords-plus = {BIOLOGICAL AEROSOL-PARTICLES; DISPERSION MODEL; ATMOSPHERIC PARTICLES; AIRBORNE MEASUREMENTS; NUCLEI POPULATIONS; BOUNDARY-LAYER; DEPOSITION; ALGORITHM; PROFILES; HYYTIALA},
