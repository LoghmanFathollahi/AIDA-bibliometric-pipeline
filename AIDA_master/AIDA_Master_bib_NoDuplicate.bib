@article{2006_stetzer_acp,
  author = {Stetzer, O. and Moehler, O. and Wagner, R. and Benz, S. and Saathoff, H. and Bunz, H. and Indris, O.},
  title = {Homogeneous nucleation rates of nitric acid dihydrate (NAD) at simulated stratospheric conditions -: Part I:: Experimental results},
