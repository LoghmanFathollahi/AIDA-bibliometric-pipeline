  doi = {10.5194/acp-10-313-2010},
  issn = {1680-7316},
  eissn = {1680-7324},
  keywords-plus = {CHAMBER; PARTICLES; NUCLEI; INSTRUMENT; CLOUDS},
  research-areas = {Environmental Sciences \& Ecology; Meteorology \& Atmospheric Sciences},
  web-of-science-categories = {Environmental Sciences; Meteorology \& Atmospheric Sciences},
  author-email = {olaf.stetzer@env.ethz.ch},
  affiliations = {Swiss Federal Institutes of Technology Domain; ETH Zurich; Helmholtz Association; Karlsruhe Institute of Technology},
  researcherid-numbers = {Lueoend, Felix/HJH-2767-2023 Lohmann, Ulrike/B-6153-2009 Möhler, Ottmar/J-9426-2012},
  orcid-numbers = {Lueoend, Felix/0000-0001-7858-1253 Lohmann, Ulrike/0000-0001-8885-3785 Möhler, Ottmar/0000-0002-7551-9814},
