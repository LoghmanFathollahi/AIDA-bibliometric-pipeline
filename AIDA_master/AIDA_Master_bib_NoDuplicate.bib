  author = {Zawadowicz, Maria A. and Abdelmonem, Ahmed and Mohr, Claudia and Saathoff, Harald and Froyd, Karl D. and Murphy, Daniel M. and Leisner, I, Thomas and Cziczo, Daniel J.},
