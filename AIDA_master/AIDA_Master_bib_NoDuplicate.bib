  author = {Cornwell, G. C. and Sultana, C. M. and Petters, M. D. and Al-Mashat, H. and Rothfuss, N. E. and Mohler, O. and DeMott, P. J. and Martin, A. C. and Prather, K. A.},
  title = {Discrimination between individual dust and bioparticles using aerosol time-of-flight mass spectrometry},
