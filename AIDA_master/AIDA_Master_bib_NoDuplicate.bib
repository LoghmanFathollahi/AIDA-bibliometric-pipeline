@article{2001_hess_epjd,
  author = {Hess, H and Asmis, KR and Leisner, T and Wöste, L},
  title = {Vibrational wave packet dynamics in the silver tetramer probed by NeNePo femtosecond pump-probe spectroscopy},
  journal = {EUROPEAN PHYSICAL JOURNAL D},
  year = {2001},
  volume = {16},
  number = {1-3},
  pages = {145-149},
