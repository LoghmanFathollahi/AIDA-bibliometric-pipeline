@article{2019_hoepfner_ng,
  author = {Hoepfner, Michael and Ungermann, Joern and Borrmann, Stephan and Wagner, Robert and Spang, Reinhold and Riese, Martin and Stiller, Gabriele and Appel, Oliver and Batenburg, Anneke M. and Bucci, Silvia and Cairo, Francesco and Dragoneas, Antonis and Friedl-Vallon, Felix and Huenig, Andreas and Johansson, Soren and Krasauskas, Lukas and Legras, Bernard and Leisner, Thomas and Mahnke, Christoph and Moehler, Ottmar and Molleker, Sergej and Mueller, Rolf and Neubert, Tom and Orphal, Johannes and Preusse, Peter and Rex, Markus and Saathoff, Harald and Stroh, Fred and Weigel, Ralf and Wohltmann, Ingo},
  title = {Ammonium nitrate particles formed in upper troposphere from ground ammonia sources during Asian monsoons},
  journal = {NATURE GEOSCIENCE},
  year = {2019},
  volume = {12},
  number = {8},
  pages = {608+},
  month = {AUG},
  abstract = {The rise of ammonia emissions in Asia is predicted to increase radiative cooling and air pollution by forming ammonium nitrate particles in the lower troposphere. There is, however, a severe lack of knowledge about ammonia and ammoniated aerosol particles in the upper troposphere and their possible effects on the formation of clouds. Here we employ satellite observations and high-altitude aircraft measurements, combined with atmospheric trajectory simulations and cloud-chamber experiments, to demonstrate the presence of ammonium nitrate particles and also track the source of the ammonia that forms into the particles. We found that during the Asian monsoon period, solid ammonium nitrate particles are surprisingly ubiquitous in the upper troposphere from the Eastern Mediterranean to the Western Pacific-even as early as in 1997. We show that this ammonium nitrate aerosol layer is fed by convection that transports large amounts of ammonia from surface sources into the upper troposphere. Impurities of ammonium sulfate allow the crystallization of ammonium nitrate even in the conditions, such as a high relative humidity, that prevail in the upper troposphere. Solid ammonium nitrate particles in the upper troposphere play a hitherto neglected role in ice cloud formation and aerosol indirect radiative forcing.},
  publisher = {NATURE PORTFOLIO},
  address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
  type = {Article},
  language = {English},
  affiliation = {Höpfner, M (Corresponding Author), Karlsruhe Inst Technol, Inst Meteorol \& Climate Res, Karlsruhe, Germany. Hoepfner, Michael; Wagner, Robert; Stiller, Gabriele; Friedl-Vallon, Felix; Johansson, Soren; Leisner, Thomas; Moehler, Ottmar; Orphal, Johannes; Saathoff, Harald, Karlsruhe Inst Technol, Inst Meteorol \& Climate Res, Karlsruhe, Germany. Ungermann, Joern; Spang, Reinhold; Riese, Martin; Krasauskas, Lukas; Mueller, Rolf; Preusse, Peter; Stroh, Fred, Forschungszentrum Julich, Inst Energy \& Climate Res, Stratosphere, Julich, Germany. Borrmann, Stephan; Appel, Oliver; Batenburg, Anneke M.; Dragoneas, Antonis; Huenig, Andreas; Mahnke, Christoph; Molleker, Sergej, Max Planck Inst Chem, Particle Chem Dept, Mainz, Germany. Borrmann, Stephan; Appel, Oliver; Batenburg, Anneke M.; Dragoneas, Antonis; Huenig, Andreas; Mahnke, Christoph; Molleker, Sergej; Weigel, Ralf, Johannes Gutenberg Univ Mainz, Inst Atmospher Phys, Mainz, Germany. Riese, Martin, Univ Wuppertal, Inst Atmospher \& Environm Res, Wuppertal, Germany. Bucci, Silvia; Legras, Bernard, Sorbonne Univ, Lab Meteorol Dynam, UMR8539, IPSL,CNRS,PSL ENS,Ecole Polytech, Paris, France. Cairo, Francesco, ISAC CNR, Inst Atmospher Sci \& Climate, Rome, Italy. Neubert, Tom, Forschungszentrum Julich, Cent Inst Engn Elect \& Analyt Elect Syst, Julich, Germany. Rex, Markus; Wohltmann, Ingo, Alfred Wegener Inst, Helmholtz Ctr Polar \& Marine Res, Potsdam, Germany.; Karlsruhe Institute of Technology; Forschungszentrum Jülich; Johannes Gutenberg University Mainz; Max Planck Institute for Chemistry; University of Wuppertal; Centre National de la Recherche Scientifique; École Polytechnique; École Normale Supérieure - PSL; Sorbonne Université; Laboratoire de Météorologie Dynamique; Institute of Atmospheric Sciences and Climate; Alfred-Wegener-Institut Helmholtz-Zentrum für Polar- und Meeresforschung},
