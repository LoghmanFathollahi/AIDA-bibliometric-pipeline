@article{2018_aaltonen_cpfi,
  author = {Aaltonen, H. L. and Jakobsson, J. K. and Diaz, S. and Zackrisson, S. and Piitulainen, E. and Londahl, J. and Wollmer, P.},
  title = {Deposition of inhaled nanoparticles is reduced in subjects with COPD and correlates with the extent of emphysema: proof of concept for a novel diagnostic technique},
  journal = {CLINICAL PHYSIOLOGY AND FUNCTIONAL IMAGING},
  year = {2018},
  volume = {38},
  number = {6},
  pages = {1008-1014},
  month = {NOV},
  abstract = {BackgroundThe diagnosis of chronic obstructive pulmonary disease (COPD) is often based on spirometry, which is not sensitive to early emphysema. We have recently described a method for assessing distal airspace dimensions by measuring recovery of nanoparticles in exhaled air after a single-breath inhalation followed by breath-hold. Recovery refers to the non-deposited particle fraction. The aim of this study was to explore differences in the recovery of exhaled nanoparticles in subjects with COPD and never-smoking controls. A secondary aim was to determine whether recovery correlates with the extent of emphysema. MethodA total of 19 patients with COPD and 19 controls underwent three repeats of single-breath nanoparticle inhalation followed by breath-hold. Particle concentrations in the inhaled aerosol, and in an alveolar sample exhaled after breath-hold, were measured to obtain recovery. FindingsThe patients with COPD had a significantly higher mean recovery than controls, 01280063 versus 0074 +/- 0058; P=0010. Also, recovery correlated significantly with computed tomography (CT) densitometry variables (P<001) and diffusing capacity for carbon monoxide (D-L,D-CO; P=0002). InterpretationHigher recovery for emphysema patients, relative to controls, is explained by larger diffusion distances in enlarged distal airspaces. The nanoparticle inhalation method shows potential to be developed towards a tool to diagnose emphysema.},
  publisher = {WILEY},
  address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
  type = {Article},
  language = {English},
  affiliation = {Wollmer, P (Corresponding Author), Skane Univ Hosp, Dept Med Imaging \& Physiol, SE-20502 Malmo, Sweden. Aaltonen, H. L.; Diaz, S.; Zackrisson, S.; Wollmer, P., Skane Univ Hosp, Dept Med Imaging \& Physiol, Lund, Sweden. Aaltonen, H. L.; Diaz, S.; Zackrisson, S.; Wollmer, P., Lund Univ, Dept Translat Med, Lund, Sweden. Jakobsson, J. K.; Londahl, J., Lund Univ, Div Ergon \& Aerosol Technol, Dept Design Sci, Fac Engn LTH, Lund, Sweden. Piitulainen, E., Lund Univ, Dept Resp Med \& Allergol, Lund, Sweden.},
  doi = {10.1111/cpf.12517},
  issn = {1475-0961},
  eissn = {1475-097X},
  keywords = {AiDA; COPD; CT densitometry; emphysema; nanoparticles; respiratory diagnostics},
  keywords-plus = {RESPIRATORY-TRACT DEPOSITION; AIRBORNE NANOPARTICLES; ULTRAFINE PARTICLES; COMPUTED DENSITY; LUNG; AIRWAYS; STANDARDIZATION; TRANSLOCATION; MORPHOMETRY; HEALTHY},
  research-areas = {Physiology},
