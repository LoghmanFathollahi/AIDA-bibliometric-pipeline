@article{2019_sempionatto_electroanaly,
  author = {Sempionatto, Juliane R. and Martin, Aida and Garcia-Carmona, Laura and Barfidokht, Abbas and Kurniawan, Jonas F. and Moreto, Jose R. and Tang, Guangda and Shin, Andrew and Liu, Xiaofeng and Escarpa, Alberto and Wang, Joseph},
  title = {Skin-worn Soft Microfluidic Potentiometric Detection System},
