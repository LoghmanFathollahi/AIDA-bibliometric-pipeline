% source: webofscience/researchers/Leisner T_.bib; openalex/researchers/thomas_leisner.bib
@article{1997_kasparian_prl,
  author = {Kasparian, J and Kramer, B and Dewitz, JP and Vajda, S and Rairoux, P and Vezin, B and Boutou, V and Leisner, T and Hubner, W and Wolf, JP and Woste, L and Bennemann, KH},
  title = {Angular dependences of third harmonic generation from microdroplets},
  journal = {PHYSICAL REVIEW LETTERS},
  year = {1997},
  volume = {78},
  number = {15},
  pages = {2952-2955},
  month = {APR 14},
  abstract = {We present experimental and theoretical results for the angular dependence of third harmonic generation of water droplets in the micrometer range (size parameter 62 < ka < 248). The third harmonic generation signal in p and s polarization obtained with ultrashort laser pulses is compared with a recently developed nonlinear extension of classical Mie theory including multipoles of order l less than or equal to 250. Both theory and experiment yield over a wide range of size parameters remarkably stable intensity maxima close to the forward and backward direction at `'magic angles.'' In contrast to linear Mie scattering, both are of comparable intensity.},
