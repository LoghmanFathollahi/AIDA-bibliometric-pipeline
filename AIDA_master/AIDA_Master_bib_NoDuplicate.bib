  keywords-plus = {SENTINEL-5 PRECURSOR; INSTRUMENT DESIGN; SPECTROMETER; MISSION; CALIBRATION; SCIAMACHY; TROPOMI; DOAS},
  research-areas = {Meteorology \& Atmospheric Sciences},
