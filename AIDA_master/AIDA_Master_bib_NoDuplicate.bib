@article{2018_holloway_pnasusa,
  author = {Holloway, Ralph L. and Hurst, Shawn D. and Garvin, Heather M. and Schoenemann, P. Thomas and Vanti, William B. and Berger, Lee R. and Hawks, John},
  title = {Endocast morphology of Homo naledi from the Dinaledi Chamber, South Africa},
  journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF AMERICA},
  year = {2018},
  volume = {115},
  number = {22},
  pages = {5738-5743},
  month = {MAY 29},
  abstract = {Hominin cranial remains from the Dinaledi Chamber, South Africa, represent multiple individuals of the species Homo naledi. This species exhibits a small endocranial volume comparable to Australopithecus, combined with several aspects of external cranial anatomy similar to larger-brained species of Homo such as Homo habilis and Homo erectus. Here, we describe the endocast anatomy of this recently discovered species. Despite the small size of the H. naledi endocasts, they share several aspects of structure in common with other species of Homo, not found in other hominins or great apes, notably in the organization of the inferior frontal and lateral orbital gyri. The presence of such structural innovations in a small-brained hominin may have relevance to behavioral evolution within the genus Homo.},
  publisher = {NATL ACAD SCIENCES},
  address = {2101 CONSTITUTION AVE NW, WASHINGTON, DC 20418 USA},
  type = {Article},
  language = {English},
  affiliation = {Holloway, RL (Corresponding Author), Columbia Univ, Dept Anthropol, New York, NY 10027 USA. Hawks, J (Corresponding Author), Univ Witwatersrand, Evolutionary Studies Inst, ZA-2000 Johannesburg, South Africa. Hawks, J (Corresponding Author), Univ Wisconsin Madison, Dept Anthropol, Madison, WI 53706 USA. Holloway, Ralph L., Columbia Univ, Dept Anthropol, New York, NY 10027 USA. Hurst, Shawn D.; Schoenemann, P. Thomas, Indiana Univ, Dept Anthropol, Bloomington, IN 47405 USA. Garvin, Heather M., Des Moines Univ, Dept Anat, Des Moines, IA 50312 USA. Garvin, Heather M.; Berger, Lee R.; Hawks, John, Univ Witwatersrand, Evolutionary Studies Inst, ZA-2000 Johannesburg, South Africa. Schoenemann, P. Thomas, Stone Age Inst, Bloomington, IN 47405 USA. Vanti, William B., Columbia Univ, Sci \& Engn Lib, New York, NY 10027 USA. Hawks, John, Univ Wisconsin Madison, Dept Anthropol, Madison, WI 53706 USA.},
  doi = {10.1073/pnas.1720842115},
  issn = {0027-8424},
  keywords = {brain evolution; human evolution; South Africa; Homo; paleoanthropology},
  keywords-plus = {BROCAS AREA; BRAIN; SKULL; ASYMMETRIES; HANDEDNESS; AUSTRALOPITHECUS; ORGANIZATION; EVOLUTION; LANGUAGE; HABILIS},
  research-areas = {Science \& Technology - Other Topics},
  web-of-science-categories = {Multidisciplinary Sciences},
  author-email = {Rlh2@columbia.edu jhawks@wisc.edu},
  affiliations = {Columbia University; Indiana University System; Indiana University Bloomington; Des Moines University; University of Witwatersrand; Columbia University; University of Wisconsin System; University of Wisconsin Madison},
  researcherid-numbers = {Berger, Lee/AAC-3484-2020 /E-6518-2016 Hurst, Shawn/IUP-1336-2023 Schoenemann, P. Thomas/MEO-1622-2025 Hawks, John/H-5737-2015 Garvin, Heather/G-9544-2019},
  orcid-numbers = {Hurst, Shawn/0000-0002-1458-759X Schoenemann, P. Thomas/0000-0002-7536-2693 Hawks, John/0000-0003-3187-3755 Garvin, Heather/0000-0002-9787-4366},
