@article{2001_busolt_epjd,
  author = {Busolt, U and Cottancin, E and Socaciu, L and Röhr, H and Leisner, T and Wöste, L},
  title = {Diffusion and aggregation of Agn-Clusters (n=2-9) on HOPG probed by fs-two-photon-photoemission},
  journal = {EUROPEAN PHYSICAL JOURNAL D},
  year = {2001},
  volume = {16},
  number = {1-3},
  pages = {297-300},
  month = {SEP},
  note = {10th International Symposium on Small Particles and Inorganic Clusters (ISSPIC 10), ATLANTA, GEORGIA, OCT 11-15, 2000},
  organization = {Georgia Inst Technol; USAF, Off Sci Res},
  abstract = {The diffusion and aggregation of preformed Ag.-clusters (n = 2-9) deposited onto a highly oriented pyrolytic graphite (HOPG) substrate is studied by two-photon-photoemission (2PPE). The sample is irradiated with ultrashort laser pulse pairs and the kinetic energy of the emitted photoelectrons is analyzed in a magnetic bottle typo thue-of-flight spectrometer. During annealing of the sample from 100 K up to room temperature, nanoparticles arc formed on the surface by diffusion and aggregation of the silver clusters. A steep increase of the total photoelectron yield at a sample temperature of about 150 K is explained by the. excitation of plasmons in the silver nanoparticles. From the kinetic energy distribution of the photoelectrons we deduce a strong variation of the work function of the sample during the formation of the nanoparticles, which is attributed to a quantum size effect.},
