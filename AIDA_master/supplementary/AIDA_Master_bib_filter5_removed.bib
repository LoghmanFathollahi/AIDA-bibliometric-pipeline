  orcid-numbers = {Kiselev, Alexei/0000-0003-0136-2428 Hiron, Thibault/0000-0002-1332-6152 Leisner, Thomas/0000-0001-9693-7671},
  funding-acknowledgement = {DFG {[}DFG-FOR-1525-6343, MO668-4-1]; Karlsruhe Institute of Technology},
