@article{1993_zielke_zm,
  author = {ZIELKE, R and SCHMIDT, A and NAUMANN, K},
  title = {COMPARISON OF DIFFERENT SEROLOGICAL METHODS FOR THE DETECTION OF THE FIRE BLIGHT PATHOGEN, ERWINIA-AMYLOVORA (BURRILL) WINSLOW ET-AL},
