@article{2022_gao_acp,
  author = {Gao, Linyu and Song, Junwei and Mohr, Claudia and Huang, Wei and Vallon, Magdalena and Jiang, Feng and Leisner, Thomas and Saathoff, Harald},
  title = {Kinetics, SOA yields, and chemical composition of seconaary organic aerosol from β-caryophyllene ozonolysis with and without nitrogen oxides between 213 and 313 K},
  journal = {ATMOSPHERIC CHEMISTRY AND PHYSICS},
  year = {2022},
