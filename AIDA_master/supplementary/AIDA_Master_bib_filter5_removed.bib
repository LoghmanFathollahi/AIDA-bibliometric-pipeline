@article{1988_reiss_appappp,
  author = {REISS, E and SCHUBERT, J and NAUMANN, K},
  title = {DETERMINATION OF MICROBIAL RESISTANCE INDUCERS AND THEIR PRELIMINARY CHARACTERIZATION},
  journal = {ARCHIV FUR PHYTOPATHOLOGIE UND PFLANZENSCHUTZ-ARCHIVES OF PHYTOPATHOLOGY AND PLANT PROTECTION},
  year = {1988},
  volume = {24},
  number = {4},
  pages = {335-340},
  abstract = {Saprophytes were isolated from the surface and inside of barley leaves and cultured on liquid media. The culture filtrates were then tested for whether they contained substances inducing resistance to yellow rust (Puccinia striformis West.), dwarf leaf rust (Puccinia hordei Otth.) or mildew (Erysiphe graminis, DC. or Sphaerotheca fuliginea Schlecht. ex Fr.) in young barley and cucumber plants, respectively. The isolate of Bacillus pumilus Meyer and Gottheil (strain 29 B 15) and an unpigmented isolate of Erwinia herbicola (Lohnis) Dye (29 B 14) appeared to be particularly active inducers. Their culture filtrates and also certain fractions thereof showed good effect against all tested pathogens after plant treatment three days prior to inoculation. To clarify the phenomenon, it is compared with the known stress defense mechanism of plants.},
