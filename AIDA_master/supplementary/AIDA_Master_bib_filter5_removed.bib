  volume = {5},
  number = {1},
  pages = {75-89},
  month = {SPR},
  abstract = {Transforming the North Korean economy into a viable economy based on individual liberty will pose some important problems. From a constitutional point of view, this paper analyzes different possibilities of property distribution in the North after reunification and discusses German experiences as a model for land distribution in North Korea. Possible property rights of citizens in the North and the South are examined. The paper proposes a pragmatic approach, enabling the political decision-makers to formulate solutions that will help the North Korean economy to recover.},
