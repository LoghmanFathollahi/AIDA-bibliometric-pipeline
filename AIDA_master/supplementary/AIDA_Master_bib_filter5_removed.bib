  cited-references = {{*}CDCP, 2010, LIST SURV LIST IN. {*}CDCP, 2009, LIST GEN INF. Dalton CB, 1997, NEW ENGL J MED, V336, P100, DOI 10.1056/NEJM199701093360204. Graves LM, 2001, INT J FOOD MICROBIOL, V65, P55, DOI 10.1016/S0168-1605(00)00501-8. HIRJI KF, 1989, AM STAT, V43, P7, DOI 10.2307/2685158. HITCHINS AD, 2009, BACTERIOLOGICAL ANAL. Jackson KA, 2010, EPIDEMIOL INFECT, V138, P1503, DOI 10.1017/S0950268810000294. LINNAN MJ, 1988, NEW ENGL J MED, V319, P823, DOI 10.1056/NEJM198809293191303. MacDonald PDM, 2005, CLIN INFECT DIS, V40, P677, DOI 10.1086/427803. {*}SAS, 2010, LOGISTIC PROC. Scallan E, 2011, EMERG INFECT DIS, V17, P7, DOI 10.3389/fmicb.2024.1374568. Seeliger H.P. R., 1979, METH MICROBIOL, V13, P31, DOI {[}10.1016/S0580-9517(08)70372-6, DOI 10.1016/S0580-9517(08)70372-6]. Tompkin R. B., 1999, Dairy, Food and Environmental Sanitation, V19, P551. Tompkin RB, 2002, J FOOD PROTECT, V65, P709, DOI 10.4315/0362-028X-65.4.709. Varma JK, 2007, CLIN INFECT DIS, V44, P521, DOI 10.1086/509920.},
