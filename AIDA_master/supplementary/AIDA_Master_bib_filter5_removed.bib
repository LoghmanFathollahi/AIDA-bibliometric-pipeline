@article{2012_lowell_oceanography,
  author = {Lowell, Robert P. and Farough, Aida and Germanovich, Leonid N. and Hebert, Laura B. and Horne, Rebecca},
  title = {A Vent-Field-Scale Model of the East Pacific Rise 9°50′N Magma-Hydrothermal System},
  journal = {OCEANOGRAPHY},
  year = {2012},
  volume = {25},
  number = {1, SI},
  pages = {158-167},
  month = {MAR},
  abstract = {This paper describes a two-limb single-pass modeling approach constrained by vent temperature, heat flow, vent geochemistry, active-source seismology, and seismically inferred circulation geometry to provide first-order constraints on crustal permeability, conductive boundary layer thickness, fluid residence times, and magma replenishment rates for the magma-hydrothermal system at the East Pacific Rise (EPR) near 9 degrees 50'N. Geochemical data from black smokers and nearby diffuse-flow patches, as well as an estimate of heat flow partitioning, suggest that nearly 90\% of the heat output stems from heat supplied by the subaxial magma chamber, even though almost 90\% of that output appears as diffuse flow at the seafloor. Estimates of magma replenishment rates are consistent with the evolution of lava chemistry over the eruption cycle between 1991-1992 and 2005-2006. If the recharge surface area is 10(5) m(2), a one-dimensional model of hydrothermal recharge using EPR 9 degrees 50'N parameters gives rise to rapid sealing as a result of anhydrite precipitation; however, if the area of recharge widens at depth to similar to 10(6) m(2), sealing by anhydrite precipitation may not significantly affect hydrothermal circulation.},
  publisher = {OCEANOGRAPHY SOC},
  address = {P.O. BOX 1931, ROCKVILLE, MD USA},
  type = {Article},
  language = {English},
  affiliation = {Lowell, RP (Corresponding Author), Virginia Tech, Dept Geosci, Blacksburg, VA 24061 USA. Lowell, Robert P.; Farough, Aida, Virginia Tech, Dept Geosci, Blacksburg, VA 24061 USA. Germanovich, Leonid N., Georgia Inst Technol, Sch Civil \& Environm Engn, Atlanta, GA 30332 USA. Hebert, Laura B., Univ Maryland, Dept Geol, College Pk, MD 20742 USA.},
  doi = {10.5670/oceanog.2012.13},
  issn = {1042-8275},
  keywords-plus = {DIFFUSE FLOW; EVOLUTION; CHAMBER},
  research-areas = {Oceanography},
  web-of-science-categories = {Oceanography},
