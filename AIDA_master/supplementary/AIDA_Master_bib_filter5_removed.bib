  keywords-plus = {POLAR SCATTERING PROBE; MICROPHYSICAL PROPERTIES; PHIPS-HALO; TEMPERATURE INVERSIONS; NUMBER CONCENTRATION; SURFACE-ALBEDO; WATER-CONTENT; PARTICLES; PARAMETERIZATION; MULTIPLICATION},
  research-areas = {Environmental Sciences \& Ecology; Meteorology \& Atmospheric Sciences},
  web-of-science-categories = {Environmental Sciences; Meteorology \& Atmospheric Sciences},
  author-email = {emma.jaervinen@kit.edu},
  affiliations = {Helmholtz Association; Karlsruhe Institute of Technology; Universite Clermont Auvergne (UCA); Centre National de la Recherche Scientifique (CNRS)},
  researcherid-numbers = {Xu, Guanglang/JAO-1357-2023 Jourdan, Olivier/JTJ-0987-2023 Dupuy, Regis/AAO-7895-2020 Järvinen, Emma/G-7120-2014 Schnaiter, Martin/A-2370-2013 Xu, Guanglang/JAO-1357-2023},
  orcid-numbers = {Mioche, Guillaume/0000-0002-1462-5277 Järvinen, Emma/0000-0001-5171-1759 Schnaiter, Martin/0000-0002-9560-8072 Xu, Guanglang/0000-0002-1741-589X},
