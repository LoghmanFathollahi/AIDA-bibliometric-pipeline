@article{2002_wurm_aj,
  author = {Wurm, G and Schnaiter, M},
  title = {Coagulation as unifying element for interstellar polarization},
  journal = {ASTROPHYSICAL JOURNAL},
  year = {2002},
  volume = {567},
  number = {1, 1},
  pages = {370-375},
  month = {MAR 1},
  abstract = {We calculate the extinction and polarization for aligned dust aggregates consisting of 4, 8, 16, 32, and 64 spherical particles (monomers). We consider a power-law size distribution of monomers and optical constants related to interstellar values. Our calculations match the polarization and extinction by the general diffuse interstellar medium. They also match the linear correlation between the observed shift (increase) of the wavelength of maximum polarization with increasing total to selective extinction (R-V). The model naturally incorporates the low values of R-V at small wavelength of maximum polarization observed in molecular clouds at high Galactic latitude. A further result of the calculations is a systematic and correlated decrease in polarization efficiency with increasing aggregate size, ruling out very large aggregates if polarization is observed. Our results also support the idea that the observed change of features in molecular clouds such as the Taurus dark clouds is rather the result of a change in alignment than a change in particle size, although the small degree of coagulation that can still be inferred is in agreement with a simple coagulation model. Therefore, small aggregates in a limited size range serve as a good and most natural model structure for interstellar dust particles, with the number of monomers being the only parameter to be adjusted.},
  publisher = {UNIV CHICAGO PRESS},
  address = {1427 E 60TH ST, CHICAGO, IL 60637-2954 USA},
  type = {Article},
  language = {English},
  affiliation = {Wurm, G (Corresponding Author), Univ Colorado, Atmospher \& Space Phys Lab, Campus Box 392, Boulder, CO 80309 USA. Univ Colorado, Atmospher \& Space Phys Lab, Boulder, CO 80309 USA. Res Ctr Karlsruhe, Inst Meteorol \& Climate Res, D-76021 Karlsruhe, Germany.; Laboratory for Atmospheric and Space Physics; Karlsruhe Institute of Technology},
  doi = {10.1086/338498},
  issn = {0004-637X},
  keywords = {dust, extinction; ISM : individual (Taurus Dark Cloud); methods : numerical; polarization; Physics; Extinction (optical mineralogy); Astrophysics; Polarization (electrochemistry); Interstellar medium; Wavelength; Molecular cloud; Cosmic dust},
  keywords-plus = {WAVELENGTH DEPENDENCE; OPTICAL-PROPERTIES; DUST; EXTINCTION; SCATTERING; ALIGNMENT; CLUSTERS; AGGREGATION; HD-210121; PARTICLES},
  research-areas = {Astronomy \& Astrophysics},
