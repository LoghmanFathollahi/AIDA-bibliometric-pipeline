  author = {Meinen, J. and Eritt, M. and Habig, J. C. and Leisner, T.},
  title = {Optical properties of free sub-10-nm diameter Fe2O3 nanoparticles studied by broad-band cavity enhanced absorption spectroscopy (BB-CEAS)},
