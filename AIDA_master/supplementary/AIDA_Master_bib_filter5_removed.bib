  doi = {10.1002/(SICI)1096-9063(199801)52:1<3::AID-PS689>3.0.CO;2-V},
  issn = {0031-613X},
  keywords = {pyrethroids; fluorinated; benzyl alcohols; knockdown activity; cypermethrin; transfluthrin; cyfluthrin},
  keywords-plus = {MUSCA-DOMESTICA; INSECTICIDES; RESISTANCE; DIPTERA},
