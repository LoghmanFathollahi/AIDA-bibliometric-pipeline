@article{2024_schmitt_jamc,
  author = {Schmitt, Carl G. and Vas, Dragos and Schnaiter, Martin and Jaervinen, Emma and Hartl, Lea and Wong, Telayna and Cassella, Victor and Stuefer, Martin},
