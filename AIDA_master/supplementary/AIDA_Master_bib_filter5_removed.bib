@article{2022_zhang_rs,
  author = {Zhang, Hengheng and Wagner, Frank and Saathoff, Harald and Vogel, Heike and Hoshyaripour, Gholamali and Bachmann, Vanessa and Foerstner, Jochen and Leisner, Thomas},
  title = {Comparison of Scanning LiDAR with Other Remote Sensing Measurements and Transport Model Predictions for a Saharan Dust Case},
