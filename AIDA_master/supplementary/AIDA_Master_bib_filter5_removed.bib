@article{2016_nink_jhep,
  author = {Nink, Andreas and Reuter, Martin},
  title = {The unitary conformal field theory behind 2D Asymptotic Safety},
  journal = {JOURNAL OF HIGH ENERGY PHYSICS},
  year = {2016},
  number = {2},
  month = {FEB 25},
  abstract = {Being interested in the compatibility of Asymptotic Safety with Hilbert space positivity (unitarity), we consider a local truncation of the functional KG flow which describes quantum gravity in d > 2 dimensions and construct its limit of exactly two dimensions. We find that in this limit the flow displays a nontrivial fixed point whose effective average action is a non-local functional of the metric. Its pure gravity sector is shown to correspond to a unitary conformal field theory with positive central charge c = 25. Representing the fixed point CFI' by a Liouville theory in the conformal gauge, we investigate its general properties and their implications for the Asymptotic Safety program. In particular, we discuss its field parametrization dependence and argue that there might exist more than one universality class of metric gravity theories in two dimensions. Furthermore, studying the gravitational dressing in 2D asymptotically safe gravity coupled to conformal matter we uncover a mechanism which leads to a complete quenching of the a priori expected Knizhnik-Polyakov-Zamolodchikov (KPZ) scaling. A possible connection of this prediction to Monte Carlo results obtained in the discrete approach to 2D quantum gravity based upon causal dynamical triangulations is mentioned. Similarities of the fixed point theory to, and differences from, non-critical string theory are also described. On the technical side, we provide a detailed analysis of an intriguing connection between the Einstein-Hilbert action in ri > 2 dimensions and Polyakov's induced gravity action in two dimensions.},
  publisher = {SPRINGER},
  address = {233 SPRING ST, NEW YORK, NY 10013 USA},
  type = {Article},
  language = {English},
  affiliation = {Nink, A; Reuter, M (Corresponding Author), Johannes Gutenberg Univ Mainz, Inst Phys, PRISMA, Staudingerweg 7, D-55099 Mainz, Germany. Nink, Andreas; Reuter, Martin, Johannes Gutenberg Univ Mainz, Inst Phys, PRISMA, Staudingerweg 7, D-55099 Mainz, Germany. Johannes Gutenberg Univ Mainz, Inst Phys, MITP, Staudingerweg 7, D-55099 Mainz, Germany.},
  doi = {10.1007/JHEP02(2016)167},
  article-number = {167},
  issn = {1029-8479},
  keywords = {Models of Quantum Gravity; 2D Gravity; Nonperturbative Effects; Renormalization Group},
  keywords-plus = {(2+EPSILON)-DIMENSIONAL QUANTUM-GRAVITY; COVARIANT PERTURBATION-THEORY; EUCLIDEAN GREENS-FUNCTIONS; EXACT EVOLUTION EQUATION; RENORMALIZATION-GROUP; AVERAGE ACTION; 2+EPSILON DIMENSIONS; GENERAL-RELATIVITY; SCALING EXPONENTS; SCALAR CURVATURE},
  research-areas = {Physics},
  web-of-science-categories = {Physics, Particles \& Fields},
  author-email = {nink@thep.physik.uni-mainz.de reuter@thep.physik.uni-mainz.de},
  affiliations = {Johannes Gutenberg University of Mainz; Johannes Gutenberg University of Mainz},
