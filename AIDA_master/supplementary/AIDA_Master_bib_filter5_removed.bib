  volume = {145},
  number = {2},
  pages = {121-133},
  abstract = {The results of more years lasting experiments demonstrate, that Erwinia amylovora, the causal agent of fireblight, can be detected in the air space of orchard by different methods. For this purpose the following techniques were successful: - monitoring by a semiselective medium (for example Miller and Schroth-medium, Brulez and Zeller-medium, Hahn-agar) - sampling by small water disks or water-filled microtest plates collecting in a water suspension using a simple suction pump equipment. The usefulness of the bacteria sampler for fireblight monitoring resp. prognose system is considerably dependent on the sensitivity and reliability of the methods of identification to be used.},
