  affiliations = {Helmholtz Association; Karlsruhe Institute of Technology; Helmholtz Association; Julich Research Centre; Helmholtz Association; Julich Research Centre; Universite Lyon 1; Centre National de la Recherche Scientifique (CNRS); CNRS - Institute of Chemistry (INC)},
  researcherid-numbers = {Gkatzelis, Georgios/R-1057-2016 Brüggemann, Nicolas/C-4263-2014 Leisner, Thomas/A-2391-2013 Tillmann, Ralf/I-9203-2012},
  orcid-numbers = {Gkatzelis, Georgios/0000-0002-4608-3695 Brüggemann, Nicolas/0000-0003-3851-2418 Saathoff, Harald/0000-0002-1301-8010 Leisner, Thomas/0000-0001-9693-7671},
