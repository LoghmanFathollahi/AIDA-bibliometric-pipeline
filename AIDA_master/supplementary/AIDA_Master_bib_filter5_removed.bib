@article{2015_marshall_epjc,
  author = {Marshall, J. S. and Thomson, M. A.},
  title = {The Pandora software development kit for pattern recognition},
  journal = {EUROPEAN PHYSICAL JOURNAL C},
  year = {2015},
  volume = {75},
  number = {9},
  month = {SEP 21},
  abstract = {The development of automated solutions to pattern recognition problems is important in many areas of scientific research and human endeavour. This paper describes the implementation of the Pandora software development kit, which aids the process of designing, implementing and running pattern recognition algorithms. The Pandora Application Programming Interfaces ensure simple specification of the building-blocks defining a pattern recognition problem. The logic required to solve the problem is implemented in algorithms. The algorithms request operations to create or modify data structures and the operations are performed by the Pandora framework. This design promotes an approach using many decoupled algorithms, each addressing specific topologies. Details of algorithms addressing two pattern recognition problems in High Energy Physics are presented: reconstruction of events at a high-energy e(+)e(-) linear collider and reconstruction of cosmic ray or neutrino events in a liquid argon time projection chamber.},
  publisher = {SPRINGER},
  address = {233 SPRING ST, NEW YORK, NY 10013 USA},
  type = {Article},
  language = {English},
  affiliation = {Marshall, JS (Corresponding Author), Univ Cambridge, Cavendish Lab, Cambridge CB3 0HE, England. Marshall, J. S.; Thomson, M. A., Univ Cambridge, Cavendish Lab, Cambridge CB3 0HE, England.},
  doi = {10.1140/epjc/s10052-015-3659-3},
  article-number = {439},
