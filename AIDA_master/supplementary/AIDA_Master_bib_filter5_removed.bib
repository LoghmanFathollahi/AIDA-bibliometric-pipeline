  doi = {10.1088/1748-0221/10/08/P08001},
  article-number = {P08001},
  issn = {1748-0221},
  keywords = {Detector cooling and thermo-stabilization; Time projection Chambers (TPC); Micropattern gaseous detectors (MSGC, GEM, THGEM, RETHGEM, MHSP, MICROPIC, MICROMEGAS, InGrid, etc); Front-end electronics for detector readout},
  research-areas = {Instruments \& Instrumentation},
  web-of-science-categories = {Instruments \& Instrumentation},
  author-email = {dsb.physics@gmail.com},
  affiliations = {Saha Institute of Nuclear Physics; CEA; Universite Paris Saclay; Jadavpur University},
  researcherid-numbers = {Attié, David/HHM-3245-2022 Ganjour, Serguei/D-8853-2011},
  orcid-numbers = {Attié, David/0000-0003-2627-6032 Bhattacharya, Deb Sankar/0000-0003-3837-4166},
  funding-acknowledgement = {CEFIPRA/IFCPAR {[}4304-01]; AIDA},
  funding-text = {We express our gratitude to KEK, Japan for financing the cooling system, TRACI. We sincerely acknowledge Jan Timmermans and Bart Verlaat of Nikhef, Amsterdam, for their overall assistance and communications. We are also thankful to Marc Riallot of CEA, Saclay. We would like to acknowledge Ralf Diener at DESY, Hamburg. Our sincere thanks to Purba Bhattacharya, Abhik Jash and Rajani Raman of SINP, Kolkata. We express our gratitude to CEFIPRA/IFCPAR (Project 4304-01) and AIDA for their partial fundings.},
