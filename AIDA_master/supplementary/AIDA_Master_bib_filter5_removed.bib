  title = {SYSTEMIC ACTION OF NEEM SEED EXTRACT ON MOUNTAIN PINE-BEETLE (COLEOPTERA, SCOLYTIDAE) IN LODGEPOLE PINE},
  journal = {JOURNAL OF ECONOMIC ENTOMOLOGY},
