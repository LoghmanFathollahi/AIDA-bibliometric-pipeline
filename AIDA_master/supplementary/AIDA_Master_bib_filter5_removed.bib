@article{1992_hizhnyakov_cp,
  author = {HIZHNYAKOV, V and SERANSKI, K and SCHURATH, U},
  title = {HOMOGENEOUS LINESHAPES AND SHIFTS OF THE B 1-SIGMA+{[}-X3-SIGMA- TRANSITION IN MATRIX-ISOLATED NH - COMPARISON WITH QUADRATIC COUPLING THEORY},
  journal = {CHEMICAL PHYSICS},
  year = {1992},
  volume = {162},
  number = {2-3},
  pages = {249-256},
  month = {MAY 15},
  abstract = {The lack of linear electron-phonon coupling in the 1-SIGMA+ <-- X 3-SIGMA- transition of matrix-isolated NH in rare gases gives rise to narrow rotational lines without phonon sidebands. Asymmetric homogeneous broadening and a systematic shift to higher frequencies of the (Q)P(0) ZPL in solid Kr has been studied systematically in the range 5-40 K. An improved version of a recently proposed non-perturbative theory of quadratic vibronic coupling is presented, and applied to the experimental result. Assuming coupling to a single low-frequency pseudolocal mode of 10 cm-1, and a state-to-state frequency change of 1.5 cm-1, excellent agreement between observed and calculated T-dependent lineshapes has been obtained. In particular, the increasing asymmetry of the line, which is purely Lorentzian at low temperature, is reproduced quantitatively.},
