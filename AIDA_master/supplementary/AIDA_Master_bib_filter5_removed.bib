  affiliations = {Virginia Polytechnic Institute \& State University; University System of Georgia; Georgia Institute of Technology; University of Maryland College Park; University System of Maryland; University of Maryland College Park},
  researcherid-numbers = {/L-7673-2017},
  funding-acknowledgement = {NSF {[}0926418]; Directorate For Geosciences; Division Of Ocean Sciences {[}0926418] Funding Source: National Science Foundation},
  funding-text = {We thank Andy Fisher and an anonymous reviewer for their thorough and insightful reviews. Liang Han provided useful insights regarding modeling of phase separation. Lei Liu provided calculations on magma convection and replenishment that shaped the ideas presented here. This research has been supported in part by NSF grant 0926418 to RPL.},
  cited-references = {Baker ET, 2007, EARTH PLANET SC LETT, V263, P140, DOI 10.1016/j.epsl.2007.09.010. Bemis K, 2012, OCEANOGRAPHY, V25, P182, DOI 10.5670/oceanog.2012.16. BREDEHOEFT JD, 1965, WATER RESOUR RES, V1, P325, DOI 10.1029/WR001i002p00325. Carbotte S.M., 2011, EOS T AM GEOPHYS UNI, V92. Chadwick B., 2011, EOS T AM GEOPHYS UNI, V92. Craft KL, 2009, GEOCHEM GEOPHY GEOSY, V10, DOI 10.1029/2009GC002707. Crone TJ, 2011, GEOPHYS RES LETT, V38, DOI 10.1029/2011GL046820. Crowell BW, 2008, GEOCHEM GEOPHY GEOSY, V9, DOI 10.1029/2008GC002103. DETRICK RS, 1987, NATURE, V326, P35, DOI 10.1038/326035a0. Farough A., 2011, THESIS VIRGINIA TECH. Ferrini VL, 2007, GEOCHEM GEOPHY GEOSY, V8, DOI 10.1029/2006GC001333. Fornari DJ, 2012, OCEANOGRAPHY, V25, P18, DOI 10.5670/oceanog.2012.02. Germanovich LN, 2011, J GEOPHYS RES-SOL EA, V116, DOI 10.1029/2009JB006588. Goss AR, 2010, GEOCHEM GEOPHY GEOSY, V11, DOI 10.1029/2009GC002977. Han L., 2011, THESIS VIRGINIA TECH. Horne R., 2010, EOS T AM GEOPHYS UNI, V91. KENT GM, 1990, NATURE, V344, P650, DOI 10.1038/344650a0. Liu L, 2009, J GEOPHYS RES-SOL EA, V114, DOI 10.1029/2008JB005846. Lowell RP, 2004, GEOPHYS MONOGR SER, V148, P219, DOI 10.1029/148GM09. Lowell RP, 2002, J GEOPHYS RES-SOL EA, V107, DOI 10.1029/2001JB001289. Nooner SL, 2009, GEOCHEM GEOPHY GEOSY, V10, DOI 10.1029/2008GC002315. Ramondenc P, 2006, EARTH PLANET SC LETT, V245, P487, DOI 10.1016/j.epsl.2006.03.023. Sohn RA, 1998, NATURE, V396, P159, DOI 10.1038/24146. Tolstoy M, 2008, NATURE, V451, P181, DOI 10.1038/nature06424. Von Damm KL, 2004, GEOPH MONOG SERIES, V148, P285, DOI 10.1029/148GM12. Von Damm KL, 2004, GEOPH MONOG SERIES, V144, P245, DOI 10.1029/144GM16.},
