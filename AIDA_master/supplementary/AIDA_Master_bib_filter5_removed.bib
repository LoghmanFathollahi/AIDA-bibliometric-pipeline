@article{2016_hollhumer_cornea,
  author = {Hollhumer, Roland and Zairani, Aida and Watson, Stephanie},
  title = {Hemorrhagic Descemet Membrane Detachment Following Syphilitic Interstitial Keratitis},
  journal = {CORNEA},
