@article{2026_gao_acp,
  author = {Gao, Linyu and Manavi, Stella E. I. and Mohr, Claudia and Song, Junwei and Wu, Cheng and Leisner, Thomas and Pandis, Spyros N. and Saathoff, Harald},
  title = {Influence of tropospheric temperature on the formation and aging of secondary organic aerosol from biogenic vapor mixtures},
  journal = {ATMOSPHERIC CHEMISTRY AND PHYSICS},
