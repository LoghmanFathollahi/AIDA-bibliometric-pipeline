  doi = {10.5194/acp-26-1277-2026},
  issn = {1680-7316},
  eissn = {1680-7324},
  keywords-plus = {OPTICAL-PROPERTIES; PARTICLE-SIZE; LIDAR; AEROSOL; SCATTERING; LIGHT; CAPABILITIES; CONTRAIL; DETECTOR; SHAPE},
  research-areas = {Environmental Sciences \& Ecology; Meteorology \& Atmospheric Sciences},
