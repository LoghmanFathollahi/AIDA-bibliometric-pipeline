  researcherid-numbers = {Schnaiter, Martin/A-2370-2013 Baltensperger, Urs/AFM-8080-2022 Gysel-Beer, Martin/C-3843-2008 Kupiszewski, Piotr/F-7395-2014 Mertes, Stephan/Y-4487-2018 Rosati, Bernadette/AAA-2099-2022 Weingartner, Ernest/B-6793-2009},
  orcid-numbers = {Schnaiter, Martin/0000-0002-9560-8072 Baltensperger, Urs/0000-0003-0079-8713 Gysel-Beer, Martin/0000-0002-7453-1264 Kupiszewski, Piotr/0000-0003-3284-813X Mertes, Stephan/0000-0001-9549-8558 Weingartner, Ernest/0000-0002-2427-4634},
