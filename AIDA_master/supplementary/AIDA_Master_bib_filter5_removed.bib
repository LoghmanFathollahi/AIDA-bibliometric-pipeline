  keywords-plus = {IN-VITRO; EPITHELIAL-CELLS; PARTICULATE MATTER; PULMONARY TOXICITY; AEROSOL-PARTICLES; SYSTEM; RESPONSES; FINE; VIVO; INHALATION},
  research-areas = {Science \& Technology - Other Topics; Materials Science; Physics},
