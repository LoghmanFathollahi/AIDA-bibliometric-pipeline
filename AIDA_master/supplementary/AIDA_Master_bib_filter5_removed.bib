@article{1986_naumann_zm_b,
  author = {NAUMANN, K and ZIELKE, R and GIERZ, E and MEYER, U},
  title = {EFFECT OF AN INOCULATION BY CORYNEBACTERIUM-SEPEDONICUM (SPIECK ET KOTTH) SKAPT ET BURKH IN POTATO CROPS BY SIMULTANEOUS INCIDENCE OF ERWINIA-CAROTOVORA SUBSP ATROSEPTICA (VANHALL) DYE},
  journal = {ZENTRALBLATT FUR MIKROBIOLOGIE},
  year = {1986},
  volume = {141},
  number = {8},
  pages = {615-631},
  abstract = {In 3 years lasting field and glass-house trials the effects of a single and a combined inoculation of tubers with the causal agents of potato black-leg and ruber soft rot, Erwinia carotovora subsp. atroseptica, and potato ring rot, Corynebacterium sepedonicum, on the development of potato crops and the tuber production were tested. The following results could be obtained: 1. By single inoculation of seed tubers with C. sepedonicum the typical symptoms of potato ring rot (occurrence of wilted plants with yellow or rolled dry leaves and of ring rot-diseased tubers at the end of the storage period) were caused and by certain varieties the incidence of black-leg disease was increased, too, in comparison with uninoculated control variants. That is to interpret as an activation of a latent E. carotovora subsp. atroseptica-infection triggered by C. sepedonicum. 2. By a combined inoculation with both causal agents-beside the typical ring rot-a significant increase of the black-leg disease compared with the single inoculation variants was to observe. Especially, the number of plants per plot and the yield of tubers were considerably diminished.},
