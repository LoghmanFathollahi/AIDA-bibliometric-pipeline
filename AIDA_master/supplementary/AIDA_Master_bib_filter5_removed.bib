  keywords-plus = {HETEROGENEOUS ICE NUCLEATION; MINERAL DUST PARTICLES; CONDENSATION NUCLEI; AEROSOL-PARTICLES; ACID; PRECIPITATION; CRYSTALS; GROWTH; HYGROSCOPICITY; ABILITY},
  research-areas = {Meteorology \& Atmospheric Sciences},
