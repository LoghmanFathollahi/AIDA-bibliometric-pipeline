@article{2002_walker_bt,
  author = {Walker, R and Specht, H},
  title = {Theoretical and physical aspects of Excimer laser trabeculotomy (ELT) ab interno with the AIDA laser operating at a wavelength of 308 nm},
  journal = {BIOMEDIZINISCHE TECHNIK},
  year = {2002},
  volume = {47},
  number = {5},
  pages = {106-110},
  month = {MAY},
  abstract = {Ablation of tissue structures containing and surrounded by water differs from tissue ablation at a surface, not only theoretically, but also in terms of outcome. In contrast to the situation often observed with surface ablation, it is shown that the trabecular meshwork in the Interior chamber of the eye can be ablated cleanly and accurately with the 308 nm Excimer laser without Causing collateral thermal damage. The reason for this is that in the trabecular meshwork, the ratio of radiation-absorbing tissue to water - which absorbs very little energy - is very small, A marked cooling effect thus results, which permits the development of only a very small amount of collateral thermal damage at the boundaries of the ablation zone.},
