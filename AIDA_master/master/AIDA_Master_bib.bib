  keywords-plus = {STRESS TOLERANCE; OXIDATIVE STRESS; SUPEROXIDE-DISMUTASE; SALT TOLERANCE; ERF; EXPRESSION; PROTEIN; PLANTS; RICE; BIOSYNTHESIS},
  research-areas = {Agriculture},
  web-of-science-categories = {Horticulture},
  author-email = {hanliebao@163.com xuzhang@vt.edu},
  affiliations = {Beijing Forestry University; Virginia Polytechnic Institute \& State University},
