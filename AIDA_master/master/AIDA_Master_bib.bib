@article{2011_kanji_acp,
  author = {Kanji, Z. A. and DeMott, P. J. and Moehler, O. and Abbatt, J. P. D.},
  title = {Results from the University of Toronto continuous flow diffusion chamber at ICIS 2007: instrument intercomparison and ice onsets for different aerosol types},
  journal = {ATMOSPHERIC CHEMISTRY AND PHYSICS},
  year = {2011},
  volume = {11},
  number = {1},
  pages = {31-41},
  abstract = {The University of Toronto continuous flow diffusion chamber (UT-CFDC) was used to study heterogeneous ice nucleation at the International Workshop on Comparing Ice Nucleation Measuring Systems (ICIS 2007) which also represented the 4-th ice nucleation workshop, on 14-28 September 2007. One goal of the workshop was to intercompare different ice nucleation measurement techniques using the same aerosol sample source and preparation method. The aerosol samples included four types of desert mineral dust, graphite soot particles, and live and dead bacterial cells (Snomax (R)). This paper focuses on the UT-CFDC results, with a comparison to techniques of established heritage including the Colorado State CFDC and the AIDA expansion chamber. Good agreement was found between the different instruments with a few specific differences, especially at low temperatures, perhaps due to the variation in how onset of ice formation is defined between the instruments and the different inherent residence times. It was found that when efficiency of ice formation is based on the lowest onset relative humidity, Snomax (R) particles were most efficient followed by the desert dusts and then soot. For all aerosols, deposition mode freezing was only observed for T <45K except for the dead bacteria where freezing occurred below water saturation as warm as 263 K.},
  publisher = {COPERNICUS GESELLSCHAFT MBH},
  address = {BAHNHOFSALLEE 1E, GOTTINGEN, 37081, GERMANY},
  type = {Article},
  language = {English},
  affiliation = {Kanji, ZA (Corresponding Author), ETH, Inst Atmospher \& Climate Sci, Zurich, Switzerland. Kanji, Z. A.; Abbatt, J. P. D., Univ Toronto, Dept Chem, Toronto, ON M5S 1A1, Canada. DeMott, P. J., Colorado State Univ, Dept Atmospher Sci, Ft Collins, CO 80523 USA. Moehler, O., Karlsruhe Inst Technol, Inst Meteorol \& Climate Res, Karlsruhe, Germany.; University of Toronto; ETH Zurich; Colorado State University; Karlsruhe Institute of Technology},
  doi = {10.5194/acp-11-31-2011},
