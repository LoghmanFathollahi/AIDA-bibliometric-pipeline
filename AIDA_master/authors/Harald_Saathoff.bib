@article{2024_wagner_jgra,
  author = {Wagner, Robert and Hu, Yaqiong and Bogert, Pia and Hoehler, Kristina and Kiselev, Alexei and Moehler, Ottmar and Saathoff, Harald and Umo, Nsikanabasi and Zanatta, Marco},
  title = {How Porosity Influences the Heterogeneous Ice Nucleation Ability of Secondary Organic Aerosol Particles},
