  funding-acknowledgement = {Atmospheric Composition Change the European NeTwork of excellence (ACCENT); NERC APPRAISE-CLOUDS {[}NE/E01125X/1]; NERC {[}NE/E01125X/1, appraise010005, NE/E011209/1] Funding Source: UKRI; Natural Environment Research Council {[}appraise010005, NE/E01125X/1, NE/E011209/1] Funding Source: researchfish},
