  researcherid-numbers = {Mélanie, GHYSELS/AGQ-9846-2022 Rosenlof, Karen/B-5652-2008 Fujiwara, Masatomo/F-7852-2012 Hertzog, Albert/A-2899-2012},
  orcid-numbers = {Brunamonti, Simone/0000-0001-7667-443X Emmenegger, Lukas/0000-0002-9812-3986 Saathoff, Harald/0000-0002-1301-8010 Tuzson, Béla/0000-0001-7442-5405 Rosenlof, Karen/0000-0002-0903-8270 Fujiwara, Masatomo/0000-0001-5567-4692 Diskin, Glenn/0000-0002-3617-0269},
