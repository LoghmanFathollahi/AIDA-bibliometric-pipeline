  doi = {10.1016/j.jphotochem.2005.08.026},
  issn = {1010-6030},
  eissn = {1873-2666},
  keywords = {cloud chamber; droplet freezing; nucleation rate; Nucleation; Supercooling; Ice nucleus; Cirrus; Graupel; Atmosphere (unit); Ice crystals},
