@article{2003_saathoff_jas_c,
  author = {Saathoff, H and Naumann, KH and Schnaiter, M and Schöck, W and Weingartner, E and Baltensperger, U and Krämer, L and Bozoki, Z and Pöschl, U and Niessner, R and Schurath, U},
  title = {Carbon mass determinations during the AIDA soot aerosol campaign 1999},
  journal = {JOURNAL OF AEROSOL SCIENCE},
  year = {2003},
  volume = {34},
