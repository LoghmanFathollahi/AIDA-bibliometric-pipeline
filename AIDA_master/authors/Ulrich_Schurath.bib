  doi = {10.1021/es015564x},
  issn = {0013-936X},
  keywords-plus = {BALLOON-BORNE; TRACE GASES; AEROSOLS; OZONE},
  research-areas = {Engineering; Environmental Sciences \& Ecology},
  web-of-science-categories = {Engineering, Environmental; Environmental Sciences},
  author-email = {schurath@imk.fzk.de},
  affiliations = {Helmholtz Association; Karlsruhe Institute of Technology; Helmholtz Association; Julich Research Centre; Hungarian Academy of Sciences},
