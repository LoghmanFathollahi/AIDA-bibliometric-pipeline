@article{2011_schoen_jaot,
  author = {Schoen, Roland and Schnaiter, Martin and Ulanowski, Zbigniew and Schmitt, Carl and Benz, Stefan and Moehler, Ottmar and Vogt, Steffen and Wagner, Robert and Schurath, Ulrich},
  title = {Particle Habit Imaging Using Incoherent Light: A First Step toward a Novel Instrument for Cloud Microphysics},
  journal = {JOURNAL OF ATMOSPHERIC AND OCEANIC TECHNOLOGY},
  year = {2011},
  volume = {28},
  number = {4},
  pages = {493-512},
  month = {APR},
  abstract = {The imaging unit of the novel cloud particle instrument Particle Habit Imaging and Polar Scattering (PHIPS) probe has been developed to image individual ice particles produced inside a large cloud chamber. The PHIPS produces images of single airborne ice crystals, illuminated with white light of an ultrafast flash-lamp, which are captured at a maximum frequency of similar to 5 Hz by a charge-coupled device (CCD) camera with microscope optics. The imaging properties of the instrument were characterized by means of crystalline sodium hexafluorosilicate ice analogs, which are stable at room temperature. The optical resolving power of the system is similar to 2 mu m. By using dedicated algorithms for image processing and analysis, the ice crystal images can be analyzed automatically in terms of size and selected shape parameters. PHIPS has been operated at the cloud simulation chamber facility Aerosol Interaction and Dynamics in the Atmosphere (AIDA) of the Karlsruhe Institute of Technology at different temperatures between -17 degrees and -4 degrees C in order to study the influence of the ambient conditions, that is, temperature and ice saturation ratio, on ice crystal habits. The area-equivalent size distributions deduced from the PHIPS images are compared with the retrieval results from Fourier transform infrared (FTIR) extinction spectroscopy in case of small (<20 mu m) and with single particle data from the cloud particle imager in case of larger (>20 mu m) ice particles. Good agreement is found for both particle size regimes.},
  publisher = {AMER METEOROLOGICAL SOC},
  address = {45 BEACON ST, BOSTON, MA 02108-3693 USA},
  type = {Article},
  language = {English},
  affiliation = {Schnaiter, M (Corresponding Author), Karlsruhe Inst Technol, Inst Meteorol \& Climate Res, Hermann von Helmholtz Pl 1, D-76344 Eggenstein Leopoldshafen, Germany. Ulanowski, Zbigniew, Univ Hertfordshire, Sci \& Technol Res Inst, Hatfield AL10 9AB, Herts, England. Schmitt, Carl, Natl Ctr Atmospher Res, Boulder, CO 80307 USA. Schoen, Roland; Schnaiter, Martin; Benz, Stefan; Moehler, Ottmar; Vogt, Steffen; Wagner, Robert; Schurath, Ulrich, Karlsruhe Inst Technol, Inst Meteorol \& Climate Res, Karlsruhe, Germany.; Karlsruhe Institute of Technology; University of Hertfordshire; NSF National Center for Atmospheric Research},
  doi = {10.1175/2011JTECHA1445.1},
  issn = {0739-0572},
  keywords-plus = {ICE NUCLEATION; CRYSTAL SHAPE; SNOW CRYSTALS; CHAMBER AIDA; CIRRUS; SCATTERING; ANALOGS; AEROSOL; GROWTH; DUST},
  research-areas = {Engineering; Meteorology \& Atmospheric Sciences},
  web-of-science-categories = {Engineering, Ocean; Meteorology \& Atmospheric Sciences},
  author-email = {martin.schnaiter@kit.edu},
  affiliations = {University of Hertfordshire; National Center Atmospheric Research (NCAR) - USA; Helmholtz Association; Karlsruhe Institute of Technology},
  researcherid-numbers = {Schnaiter, Martin/A-2370-2013 Möhler, Ottmar/J-9426-2012 Wagner, Robert/M-6129-2017 Schmitt, Carl/P-5490-2015},
