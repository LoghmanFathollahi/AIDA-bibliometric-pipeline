  funding-acknowledgement = {MIT International Science and Technology Initiative-Germany (MISTI-Germany); European project EUROCHAMP2 (Transnational Access Activity) {[}E2-2012-05-14-0075]; DFG HALO priority program {[}SPP 1294, MOEH 668/1-2]},
