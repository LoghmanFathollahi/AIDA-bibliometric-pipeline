  doi = {10.1002/jgre.20155},
  issn = {2169-9097},
  eissn = {2169-9100},
  keywords = {Martian clouds; ice nucleation; Atmosphere of Mars; Mars Exploration Program; Cirrus; Martian; Astrobiology; Atmospheric sciences; Ice nucleus; Ice cloud; Atmosphere (unit)},
  keywords-plus = {CLOUD FORMATION; WATER-VAPOR; SIZE; ATMOSPHERE; PARTICLES; SATURATION; MODEL; SOOT},
  research-areas = {Geochemistry \& Geophysics},
