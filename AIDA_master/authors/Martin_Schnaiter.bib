  language = {English},
  affiliation = {Cotton, RJ (Corresponding Author), Met Off, Exeter EX1 3PB, Devon, England. Met Off, Exeter EX1 3PB, Devon, England. Forschungszentrum Karlsruhe, Inst Meteorol \& Climate Res, Karlsruhe, Germany.; Met Office; NSF National Center for Atmospheric Research},
