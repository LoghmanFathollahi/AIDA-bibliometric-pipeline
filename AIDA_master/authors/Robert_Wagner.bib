  researcherid-numbers = {Möhler, Ottmar/J-9426-2012 Wagner, Robert/M-6129-2017 Höhler, Kristina/A-2347-2013 Umo, Nsikanabasi Silas/AAX-5974-2021 Kiselev, Alexei/A-3036-2013},
  orcid-numbers = {Zanatta, Marco/0000-0002-7711-6808 Möhler, Ottmar/0000-0002-7551-9814 Wagner, Robert/0000-0001-9419-5432 Höhler, Kristina/0000-0001-5503-9816 Umo, Nsikanabasi Silas/0000-0002-2571-163X Kiselev, Alexei/0000-0003-0136-2428 Hu, Yaqiong/0000-0003-3710-7488},
