  title = {Solid Ammonium Nitrate Aerosols as Efficient Ice Nucleating Particles at Cirrus Temperatures},
  journal = {JOURNAL OF GEOPHYSICAL RESEARCH-ATMOSPHERES},
  year = {2020},
  volume = {125},
