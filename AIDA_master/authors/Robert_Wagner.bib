  title = {The Influence of Chemical and Mineral Compositions on the Parameterization of Immersion Freezing by Volcanic Ash Particles},
  journal = {JOURNAL OF GEOPHYSICAL RESEARCH-ATMOSPHERES},
  year = {2021},
  volume = {126},
