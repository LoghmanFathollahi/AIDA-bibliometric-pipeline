@article{2016_vochezer_amt,
  author = {Vochezer, P. and Jaervinen, E. and Wagner, R. and Kupiszewski, P. and Leisner, T. and Schnaiter, M.},
  title = {In situ characterization of mixed phase clouds using the Small Ice Detector and the Particle Phase Discriminator},
  journal = {ATMOSPHERIC MEASUREMENT TECHNIQUES},
  year = {2016},
  volume = {9},
  number = {1},
  pages = {159-177},
  abstract = {Mixed phase clouds (MPCs) represent a great source of uncertainty for both climate predictions and weather forecasts. In particular, there is still a lack of understanding on how ice forms in these clouds. In this work we present a technique to analyze in situ measurements of MPCs performed with the latest instruments from the Small Ice Detector family. These instruments record high-resolution scattering patterns of individual small cloud particles. For the analysis of the scattering patterns we developed an algorithm that can discriminate the phase of the cloud particles. In the case of a droplet, a Mie solution is fitted to the recorded pattern and the size of the corresponding particle is obtained, which allows for a size calibration of the instrument. In the case of an ice particle, its shape is deduced from the scattering pattern. We apply our data analysis method to measurements from three distinct MPC types. The results from laboratory measurements demonstrate that our technique can discriminate between droplets and ice particles in the same optical size range. This ability was verified by measurements at a mountain top station where we found an alternation of liquid- and ice-dominated cloud regions. The analysis of results from aircraft-based measurements illustrates the ice detection threshold of the technique.},
  publisher = {COPERNICUS GESELLSCHAFT MBH},
  address = {BAHNHOFSALLEE 1E, GOTTINGEN, 37081, GERMANY},
  type = {Article},
  language = {English},
  affiliation = {Schnaiter, M (Corresponding Author), Karlsruhe Inst Technol, Inst Meteorol \& Climate Res Atmospher Aerosol Res, D-76021 Karlsruhe, Germany. Vochezer, P.; Jaervinen, E.; Wagner, R.; Leisner, T.; Schnaiter, M., Karlsruhe Inst Technol, Inst Meteorol \& Climate Res Atmospher Aerosol Res, D-76021 Karlsruhe, Germany. Kupiszewski, P., Paul Scherrer Inst, Lab Atmospher Chem, Villigen, Switzerland.; Karlsruhe Institute of Technology; Paul Scherrer Institute},
  doi = {10.5194/amt-9-159-2016},
  issn = {1867-1381},
  eissn = {1867-8548},
  keywords-plus = {LIGHT-SCATTERING; HOLOGRAPHIC INSTRUMENT; SIZE DISTRIBUTIONS; SIMULATION CHAMBER; CRYSTALS; WATER; JUNGFRAUJOCH; NUCLEATION; LIQUID; DROPLETS},
  research-areas = {Meteorology \& Atmospheric Sciences},
  web-of-science-categories = {Meteorology \& Atmospheric Sciences},
  author-email = {martin.schnaiter@kit.edu},
  affiliations = {Helmholtz Association; Karlsruhe Institute of Technology; Swiss Federal Institutes of Technology Domain; Paul Scherrer Institute},
  researcherid-numbers = {Schnaiter, Martin/A-2370-2013 Kupiszewski, Piotr/F-7395-2014 Leisner, Thomas/A-2391-2013 Wagner, Robert/M-6129-2017 Järvinen, Emma/G-7120-2014},
  orcid-numbers = {Schnaiter, Martin/0000-0002-9560-8072 Kupiszewski, Piotr/0000-0003-3284-813X Leisner, Thomas/0000-0001-9693-7671 Wagner, Robert/0000-0001-9419-5432 Järvinen, Emma/0000-0001-5171-1759},
