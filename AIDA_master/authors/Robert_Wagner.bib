  doi = {10.5194/acp-6-3023-2006},
  issn = {1680-7316},
  keywords-plus = {EXPLAIN DENITRIFICATION; LABORATORY EVIDENCE; ANTARCTIC OZONE; CLOUD PARTICLES; AEROSOLS; ICE; TEMPERATURES; DEPLETION; SPECTRA; INSUFFICIENT},
