@article{2005_mangold_mz,
  author = {Mangold, A and Wagner, R and Saathoff, H and Schurath, U and Giesemann, C and Ebert, V and Krämer, M and Möhler, O},
  title = {Experimental investigation of ice nucleation by different types of aerosols in the aerosol chamber AIDA:: implications to microphysics of cirrus clouds},
