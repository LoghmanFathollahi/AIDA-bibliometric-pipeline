  orcid-numbers = {Ulanowski, Zbigniew/0000-0003-4761-6980 Heymsfield, Andrew/0000-0003-4107-7533 Mioche, Guillaume/0000-0002-1462-5277 Abdelmonem, Ahmed/0000-0002-4348-2439 Schmitt, Carl/0000-0003-3829-6970 Wagner, Robert/0000-0001-9419-5432 Schnaiter, Martin/0000-0002-9560-8072 Järvinen, Emma/0000-0001-5171-1759},
