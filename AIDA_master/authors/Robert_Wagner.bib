@article{2016_nichman_acp,
  author = {Nichman, Leonid and Fuchs, Claudia and Jaervinen, Emma and Ignatius, Karoliina and Hoeppel, Niko Florian and Dias, Antonio and Heinritzi, Martin and Simon, Mario and Trostl, Jasmin and Wagner, Andrea Christine and Wagner, Robert and Williamson, Christina and Yan, Chao and Connolly, Paul James and Dorsey, James Robert and Duplissy, Jonathan and Ehrhart, Sebastian and Frege, Carla and Gordon, Hamish and Hoyle, Christopher Robert and Kristensen, Thomas Bjerring and Steiner, Gerhard and Donahue, Neil McPherson and Flagan, Richard and Gallagher, Martin William and Kirkby, Jasper and Moehler, Ottmar and Saathoff, Harald and Schnaiter, Martin and Stratmann, Frank and Tome, Antonio},
  title = {Phase transition observations and discrimination of small cloud particles by light polarization in expansion chamber experiments},
  journal = {ATMOSPHERIC CHEMISTRY AND PHYSICS},
