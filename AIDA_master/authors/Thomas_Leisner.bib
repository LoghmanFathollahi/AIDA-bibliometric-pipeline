  orcid-numbers = {Malkin, Tain/0000-0001-7314-0870 Schnaiter, Martin/0000-0002-9560-8072 Murray, Benjamin/0000-0002-8198-8131 Möhler, Ottmar/0000-0002-7551-9814 Saathoff, Harald/0000-0002-1301-8010 Leisner, Thomas/0000-0001-9693-7671},
  funding-acknowledgement = {Helmholtz-Gemeinschaft deutscher Forschungszentren; EUROCHAMP-2 (Integration of European Simulation Chambers for Investigating Atmospheric Processes) project within the EC 7th framework programme; European Research Council {[}240449 - ICE]; Deutsche Forschungsgemeinschaft; Karlsruhe Institute of Technology; European Research Council (ERC) {[}240449] Funding Source: European Research Council (ERC)},
