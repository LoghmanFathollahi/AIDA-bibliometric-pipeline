@article{2024_jiang_acp,
  author = {Jiang, Feng and Siemens, Kyla and Linke, Claudia and Li, Yanxia and Gong, Yiwei and Leisner, Thomas and Laskin, Alexander and Saathoff, Harald},
  title = {Molecular analysis of secondary organic aerosol and brown carbon from the oxidation of indole},
  journal = {ATMOSPHERIC CHEMISTRY AND PHYSICS},
