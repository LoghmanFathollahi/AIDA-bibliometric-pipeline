  researcherid-numbers = {Connolly, Paul/ABD-1752-2020 Leisner, Thomas/A-2391-2013 DeMott, Paul/C-4389-2011 Hoose, Corinna/A-4295-2009 Vogel, Bernhard/A-9558-2013 Möhler, Ottmar/J-9426-2012 Vogel, Heike/A-3196-2013},
