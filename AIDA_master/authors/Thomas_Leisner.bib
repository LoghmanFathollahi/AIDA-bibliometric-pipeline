@article{2019_ullrich_jas,
  author = {Ullrich, Romy and Hoose, Corinna and Cziczo, Daniel J. and Froyd, Karl D. and Schwarz, Joshua P. and Perring, Anne E. and Bui, Thaopaul V. and Schmitt, Carl G. and Vogel, Bernhard and Rieger, Daniel and Leisner, Thomas and Moehler, Ottmar},
  title = {Comparison of Modeled and Measured Ice Nucleating Particle Composition in a Cirrus Cloud},
  journal = {JOURNAL OF THE ATMOSPHERIC SCIENCES},
  year = {2019},
  volume = {76},
  number = {4},
