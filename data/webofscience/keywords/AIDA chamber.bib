   Mahrt, Fabian and Marsden, Nicholas A. and Mohr, Claudia and Murphy,
   Daniel M. and Saathoff, Harald and Schneider, Johannes and Wilson,
   Jacqueline and Zawadowicz, Maria A. and Zelenyuk, Alla and DeMott, Paul
   J. and Moehler, Ottmar and Cziczo, Daniel J.},
Title = {Measurement report: The Fifth International Workshop on Ice Nucleation
   phase 1 (FIN-01): intercomparison of single-particle mass spectrometers},
Journal = {ATMOSPHERIC CHEMISTRY AND PHYSICS},
Year = {2024},
