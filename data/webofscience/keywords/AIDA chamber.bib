@article{ WOS:000470992500143,
Author = {Marques, Patrice and Collado, Aida and Martinez-Hervas, Sergio and
   Domingo, Elena and Benito, Esther and Piqueras, Laura and Real, Jose T.
   and Ascaso, Juan F. and Sanz, Maria-Jesus},
Title = {Systemic Inflammation in Metabolic Syndrome: Increased Platelet and
   Leukocyte Activation, and Key Role of
   CX3CL1/CX3CR1 and CCL2/CCR2 Axes in Arterial
   Platelet-Proinflammatory Monocyte Adhesion},
Journal = {JOURNAL OF CLINICAL MEDICINE},
Year = {2019},
Volume = {8},
Number = {5},
Month = {MAY},
Abstract = {Background: Metabolic syndrome is associated with low-grade systemic
   inflammation, which is a key driver of premature atherosclerosis. We
   characterized immune cell behavior in metabolic syndrome, its
   consequences, and the potential involvement of the CX(3)CL1/CX(3)CR1 and
   CCL2/CCR2 chemokine axes. Methods: Whole blood from 18 patients with
   metabolic syndrome and 21 age-matched controls was analyzed by flow
   cytometry to determine the leukocyte immunophenotypes, activation,
   platelet-leukocyte aggregates, and CX(3)CR1 expression. ELISA determined
   the plasma marker levels. Platelet-leukocyte aggregates adhesion to
   tumor necrosis factor- (TNF)-stimulated arterial endothelium and the
   role of CX(3)CL1/CX(3)CR1 and CCL2/CCR2 axes was investigated with the
   parallel-plate flow chamber. Results: When compared with the controls,
   the metabolic syndrome patients presented greater percentages of
   eosinophils, CD3(+) T lymphocytes, Mon2/Mon3 monocytes,
   platelet-eosinophil and -lymphocyte aggregates, activated platelets,
   neutrophils, eosinophils, monocytes, and CD8(+) T cells, but lower
   percentages of Mon1 monocytes. Patients had increased circulating
   interleukin-8 (IL-8) and TNF levels and decreased IL-4. CX(3)CR1
   up-regulation in platelet-Mon1 monocyte aggregates in metabolic syndrome
   patients led to increased CX(3)CR1/CCR2-dependent platelet-Mon1 monocyte
   adhesion to dysfunctional arterial endothelium. Conclusion: We provide
   evidence of generalized immune activation in metabolic syndrome.
   Additionally, CX(3)CL1/CX(3)CR1 or CCL2/CCR2 axes are potential
   candidates for therapeutic intervention in cardiovascular disorders in
   metabolic syndrome patients, as their blockade impairs the augmented
   arterial platelet-Mon1 monocyte aggregate adhesiveness, which is a key
   event in atherogenesis.},
Publisher = {MDPI},
Address = {ST ALBAN-ANLAGE 66, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Sanz, MJ (Corresponding Author), Univ Valencia, Dept Pharmacol, Av Blasco Ibanez 15, Valencia 46010, Spain.
   Ascaso, JF; Sanz, MJ (Corresponding Author), Inst Hlth Res INCLIVA, Av Menendez Pelayo 4, Valencia 46010, Spain.
   Ascaso, JF (Corresponding Author), Univ Valencia, Fac Med \& Odontol, Dept Med, Av Blasco Ibanez 15, Valencia 46010, Spain.
   Ascaso, JF (Corresponding Author), Univ Clin Hosp Valencia, Endocrinol \& Nutr Serv, Av Menendez Pelayo 4, Valencia 46010, Spain.
