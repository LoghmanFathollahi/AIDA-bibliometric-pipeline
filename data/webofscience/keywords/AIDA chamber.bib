Month = {MAR},
Abstract = {Thermal stability of bat roosts in tropical urban structures remains
   understudied despite its conservation relevance. We monitored two
   Colombian Caribbean fortresses, finding chambers with reproductive
   mormoopid colonies were 5 degrees C-9 degrees C warmer than unoccupied,
   peaking at 39 degrees C. This first documented tropical urban `hot
   roost' is critical for conserving cave-specialist bats in cities.},
