@article{ WOS:000176260100001,
Author = {Walker, R and Specht, H},
Title = {Theoretical and physical aspects of Excimer laser trabeculotomy (ELT) ab
   interno with the AIDA laser operating at a wavelength of 308 nm},
Journal = {BIOMEDIZINISCHE TECHNIK},
Year = {2002},
Volume = {47},
Number = {5},
Pages = {106-110},
Month = {MAY},
Abstract = {Ablation of tissue structures containing and surrounded by water differs
   from tissue ablation at a surface, not only theoretically, but also in
   terms of outcome. In contrast to the situation often observed with
   surface ablation, it is shown that the trabecular meshwork in the
   Interior chamber of the eye can be ablated cleanly and accurately with
   the 308 nm Excimer laser without Causing collateral thermal damage. The
   reason for this is that in the trabecular meshwork, the ratio of
   radiation-absorbing tissue to water - which absorbs very little energy -
   is very small, A marked cooling effect thus results, which permits the
   development of only a very small amount of collateral thermal damage at
   the boundaries of the ablation zone.},
