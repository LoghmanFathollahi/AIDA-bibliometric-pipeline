@article{ WOS:000262994200017,
Author = {Raupach, Sebastian M. F.},
Title = {Cascaded adaptive-mask algorithm for twin-image removal and its
   application to digital holograms of ice crystals},
Journal = {APPLIED OPTICS},
Year = {2009},
Volume = {48},
Number = {2},
Pages = {287-301},
Month = {JAN 10},
Abstract = {An iterative Gerchberg-Saxton-type algorithm with a support constraint
   for twin-image removal from reconstructed Gabor inline holograms of
   single plane objects is described. It is applied to simulated holograms
   and to holograms of ice crystals recorded in the laboratory and in
   atmospheric clouds in situ. The algorithm is characterized by a
   distinction between object and background region and an iterative
   adaption of the object mask. Applying the algorithm to recorded inline
   holograms of atmospheric objects, the twin-image artifacts are removed
   successfully, for the first time allowing for a proper access to the in
   situ phase information on atmospheric ice crystals. It is also
   demonstrated that, after application of the algorithm, previously
   indiscernible internal object features can become visible for large
   Fresnel numbers. (C) 2009 Optical Society of America},
Publisher = {OPTICAL SOC AMER},
Address = {2010 MASSACHUSETTS AVE NW, WASHINGTON, DC 20036 USA},
