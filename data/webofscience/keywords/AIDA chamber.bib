@article{ WOS:000452637900004,
Author = {Jose Reyes-Perez, Juan and Alexander Enriquez-Acosta, Emmanuel and Angel
   Ramirez-Arrebato, Miguel and Tania Rodriguez-Pedroso, Aida and
   Falcon-Rodriguez, Alejandro},
Title = {Application of Quitomax® on tomato crop (Solanum
   lycopersicum L.) and evaluation of its effect in the yield and
   nutritional value},
Journal = {REVISTA DE LA FACULTAD DE AGRONOMIA DE LA UNIVERSIDAD DEL ZULIA},
Year = {2018},
Volume = {35},
Number = {4},
Pages = {463-475},
Month = {OCT-DEC},
Abstract = {The need for a healthier diet with fewer agrochemicals requires the use
   of biostimulants such as Quitomax (R). In the present research, several
   Quitomax (R) concentrations applied on tomato plants (Solanum
   lycopersicum L.) var. Floradade were evaluated on crop yield indicators
   and nutritional value of tomato fruits. Plants were achieved by planting
   seeds on trays contain Sogemix as commercial substrate when they reached
   15 cm height they were trasplanting to 1 kg bag with Sogemix and sand.
   Treatments consist in foliar application of Quitomax (R) at 100, 200 y
   300 mg.ha(-1) 20 y 25 day after transplanting. Crop yield indicators
   evaluated were number of flower clusters, in four phases: beginning of
   flowering, massive flowering, beginning of fruiting, massive fruiting.
   Additionally fruit numbers, fruit equatorial and polar diameters, fresh
   biomass, thickness of the mesocarp, number of chambers of the fruits
   were evaluated, as well as crop yield. In addition, protein content and
   the acidity percentage in the fruits were also evaluated. In general,
   the plants that received Quitomax (R) especially at the highest dose,
   300 mg.ha(-1) had a higher number of flower clusters and better crop
   yield indicators than the control and the treatments with lower Quitomax
   (R) concentrations. Additionally resulting fruits from chitosan-treated-
   plants showed higher protein contents and less acidity which improve
   their nutritional values.},
