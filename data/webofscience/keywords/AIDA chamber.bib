Author = {Sempionatto, Juliane R. and Martin, Aida and Garcia-Carmona, Laura and
   Barfidokht, Abbas and Kurniawan, Jonas F. and Moreto, Jose R. and Tang,
   Guangda and Shin, Andrew and Liu, Xiaofeng and Escarpa, Alberto and
