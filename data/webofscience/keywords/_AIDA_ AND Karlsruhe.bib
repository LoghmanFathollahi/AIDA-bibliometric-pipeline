@article{ WOS:000185856300001,
Author = {Saathoff, H and Mohler, O and Schurath, U and Kamm, S and Dippel, B and
   Mihelcic, D},
Title = {The AIDA soot aerosol characterisation campaign 1999},
Journal = {JOURNAL OF AEROSOL SCIENCE},
