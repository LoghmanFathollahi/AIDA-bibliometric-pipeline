@article{ WOS:001596561900001,
Author = {Newcomer, Kelley and Bifolco, Alessandro and Reeves, Sarah and
   Pontecorvi, Giada and Asawa, Simran and Sznurkowska, Magdalena K. and
   Nuesch, Manuel and Ozimski, Lauren L. and Bolm, Louisa and Sieren, Malte
