@article{ WOS:A1992HK38700013,
Author = {SANDER, R and MENZEL, R and NAUMANN, KH},
Title = {SOLVENT INDUCED BROADENING OF FLUORESCENT ELECTRONIC-TRANSITIONS OF
   PARATERPHENYL},
Journal = {BERICHTE DER BUNSEN-GESELLSCHAFT-PHYSICAL CHEMISTRY CHEMICAL PHYSICS},
Year = {1992},
Volume = {96},
Number = {2},
Pages = {188-194},
Month = {FEB},
Abstract = {We investigate the solvent influence to the inhomogeneous broadening of
   the fluorescent electronic transitions of paraterphenyl. The broadening
   is described in a phenomenological way by modeling the measured spectra
   with a sum of Gaussian functions. Lorentzian functions are also tested.
   Although the solvent properties are varied considerably the halfwidth of
   these subbands only changes about +/- 12\%. Molecular dynamic
   calculations predicted an influence of geometric solvent parameters like
   packing density and solvent diameter to the inhomogeneous broadening. A
   method for the calculation of these parameters from thermodynamic
   properties of the solvents is presented. The halfwidths of the fitted
   subbands are discussed as functions of several solvent parameters (e.g.
   dielectric constant, geometric solvent parameters). By normalizing the
   halfwidths to a constant packing density of solvent molecules the
   correlations can be improved. It becomes evident, that geometric solvent
   properties do have at least a similar effect to inhomogeneous broadening
   of the measured electronic transitions than other solvent parameters.},
