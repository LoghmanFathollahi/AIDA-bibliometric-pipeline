@article{ WOS:A1988Q986600002,
Author = {NAUMANN, K and KARL, H and ZIELKE, R and SCHMIDT, A and GRIESBACH, E},
Title = {COMPARING ANALYSIS OF BEAN-SEEDS ON INCIDENCE BY THE CAUSAL AGENT OF
   HALO BLIGHT, PSEUDOMONAS-SYRINGAE PV PHASEOLICOLA (BURKHOLDER) YOUNG ET
   AL, BY DIFFERENT IDENTIFICATION METHODS .2. DETECTION BY BIOLOGICAL
   TESTS},
Journal = {ZENTRALBLATT FUR MIKROBIOLOGIE},
Year = {1988},
Volume = {143},
Number = {7},
Pages = {499-509},
Abstract = {Following a communication concerning the usage of nutrient media and 2
   serological tests (enzyme-linked immunosorbent assay (ELISA) and
   immunofluorescence technique (IFT)) in this paper results obtained by
   applying biological methods for testing bean seeds on incidence by
   Pseudomonas syringae pv. phasolicola, the causal agent of halo bright,
   are presented. A direct detection of bean seeds infested by a single
   growingup test is recommended; seedlings infected can be found by
   typical lesions being developed on their cotyledons. However, because of
   the low percentage of seeds infected this method requires the checking
   of a lot of seeds. Cells of the pathogen can be also indirectly detected
   in rinsing water, in which beans were submerged and shaked single or as
   collected sample for 6 h (22 .degree.C), by submerging inoculation of
   healthy seedlings as a laboratory test the inoculation of primary leaves
   by vacuum infiltration and abrasion technique and of trifoliate leaves
   by vacuum  infiltration and abrasion technique in glass-house tests. The
   critical concentration of the different methods varies between 103 and
   104 cells/ml, the vacuum infiltration technique is the most sensitive
   one (102 cells/ml). The method of submerging seedlings in test fluids is
   also useful for evaluating the virulence of different isolates of Ps.
   syringae pv. phaseolicola, if an inoculum density of 108 cells/ml is
   used. The cultivars ``Esto{''}, ``Dilana{''}, ``Jutta{''}, ``Rela{''}
   and ``Berggold{''} were well suitable for all inoculation tests,
   however, ``Valja{''} did not sensitively enough react. Infusion of seeds
   in test fluids proved a failure, because by this method in many cases
   putrefaction was induced. The advantages and disadvantages of the
   different techniques for detecting bean seeds infested by halo blight
   organism are discussed.},
Publisher = {GUSTAV FISCHER VERLAG JENA},
Address = {VILLENGANG 2, D-07745 JENA, GERMANY},
Type = {Article},
Language = {German},
Affiliation = {NAUMANN, K (Corresponding Author), AKAD LANDWIRTSCHAFTSWISSENSCH DDR, INST PHYTOPATHOL ASCHERSLEBEN, THEODOR ROEMER WEG, DDR-4320 ASCHERSLEBEN, GERMANY.},
