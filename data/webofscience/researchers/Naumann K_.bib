@article{ WOS:A1988Q302500009,
Author = {REISS, E and SCHUBERT, J and NAUMANN, K},
Title = {DETERMINATION OF MICROBIAL RESISTANCE INDUCERS AND THEIR PRELIMINARY
   CHARACTERIZATION},
Journal = {ARCHIV FUR PHYTOPATHOLOGIE UND PFLANZENSCHUTZ-ARCHIVES OF PHYTOPATHOLOGY
   AND PLANT PROTECTION},
Year = {1988},
Volume = {24},
Number = {4},
Pages = {335-340},
Abstract = {Saprophytes were isolated from the surface and inside of barley leaves
   and cultured on liquid media. The culture filtrates were then tested for
   whether they contained substances inducing resistance to yellow rust
   (Puccinia striformis West.), dwarf leaf rust (Puccinia hordei Otth.) or
   mildew (Erysiphe graminis, DC. or Sphaerotheca fuliginea Schlecht. ex
   Fr.) in young barley and cucumber plants, respectively. The isolate of
   Bacillus pumilus Meyer and Gottheil (strain 29 B 15) and an unpigmented
   isolate of Erwinia herbicola (Lohnis) Dye (29 B 14) appeared to be
   particularly active inducers. Their culture filtrates and also certain
