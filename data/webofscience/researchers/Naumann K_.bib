@article{ WOS:A1990CR98800009,
Author = {FICKE, W and EHRIG, F and NACHTIGALL, M and NAUMANN, K and RICHTER, K
   and SCHAEFER, HJ and ZIELKE, R},
Title = {POSSIBILITIES FOR DETECTING OF THE CAUSAL AGENT OF FIREBLIGHT
   (ERWINIA-AMYLOVORA (BURRILL) WINSLOW ET-AL) IN THE AIR SPACE OF ORCHARDS},
Journal = {ZENTRALBLATT FUR MIKROBIOLOGIE},
Year = {1990},
Volume = {145},
Number = {2},
Pages = {121-133},
Abstract = {The results of more years lasting experiments demonstrate, that Erwinia
   amylovora, the causal agent of fireblight, can be detected in the air
   space of orchard by different methods. For this purpose the following
   techniques were successful: - monitoring by a semiselective medium (for
   example Miller and Schroth-medium, Brulez and Zeller-medium, Hahn-agar)
   - sampling by small water disks or water-filled microtest plates
   collecting in a water suspension using a simple suction pump equipment.
   The  usefulness of the bacteria sampler for fireblight monitoring resp.
   prognose system is considerably dependent on the sensitivity and
   reliability of the methods of identification to be used.},
