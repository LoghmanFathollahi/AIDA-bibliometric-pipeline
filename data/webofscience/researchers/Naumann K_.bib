Volume = {44},
Number = {25},
Pages = {2255-2257},
Month = {DEC},
Abstract = {The special incubus for the patient evoked by surgical interventions
   united with patient-own activities to overcome them and the influence on
   the course of the operation and the progress of recovery are explained.
   Variables of the individuality and the parameters of feeling have been
   recorded by psychodiagnostic methods in empirical studies at
   heart-patients and those needing in a general surgical treatment. This
   fact led to the proof of differentiated forms in the overcoming of 
   operations-types by patients who differ from one another in the
   mastering of the event and the postoperative attitude. These types of
   accomplishment are the starting points for reflections on methods
   applyable in the psychological training for an operation according to
   personality feature.},
