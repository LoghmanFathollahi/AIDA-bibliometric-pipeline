@article{ WOS:000299068400009,
Author = {Brauch, Sebastian and Henze, Michael and Osswald, Bianca and Naumann,
   Kai and Wessjohann, Ludger A. and van Berkel, Sander S. and Westermann,
   Bernhard},
Title = {Fast and efficient MCR-based synthesis of clickable rhodamine tags for
   protein profiling},
Journal = {ORGANIC \& BIOMOLECULAR CHEMISTRY},
Year = {2012},
Volume = {10},
Number = {5},
Pages = {958-965},
Abstract = {Protein profiling probes are important tools for studying the
   composition of the proteome and as such have contributed greatly to the
   understanding of various complex biological processes in higher
   organisms. For this purpose the application of fluorescently labeled
   activity or affinity probes is highly desirable. Especially for in vivo
   detection of low abundant target proteins, otherwise difficult to
   analyse by standard blotting techniques, fluorescently labeled profiling
   probes are of high value. Here, a one-pot protocol for the synthesis of
   activated fluorescent labels (i.e. azide, alkynyl or NHS), based on the
   Ugi-4-component reaction (Ugi-4CR), is presented. As a result of the
   peptoidic structure formed, the fluorescent properties of the products
   are pH insensitive. Moreover, the applicability of these probes, as
   exemplified by the labeling of model protein BSA, will be discussed.},
