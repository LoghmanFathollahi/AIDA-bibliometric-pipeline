Title = {Toxicity of a neem (Azadirachta indica A. Juss) insecticide to larval
   honey bees},
Journal = {AMERICAN BEE JOURNAL},
Year = {1996},
Volume = {136},
Number = {7},
Pages = {518-520},
Month = {JUL},
Abstract = {The effects of a neem-based insecticide on larval honey bees, Apis
   mellifera L., was examined by applying the insecticide to larvae in
   their cells. The LD50 values are higher than those reported for most
   other insect species, The potential for the transport of neem from
   sprayed crops to the nest via contaminated nectar and pollen was
   assessed by measuring the rate of translocation of the main A.I.,
   azadirachtin, from leaf surfaces to the nectar or pollen of blossoming
   canola, Brassica campestris L. No such translocation was detected.},
