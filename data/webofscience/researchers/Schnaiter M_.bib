Title = {CIRRUS-HL: Picturing High-and Midlatitude Summer Cirrus and Contrail
   Cirrus above Europe with Airborne Measurements aboard the Research
   Aircraft HALO},
Journal = {BULLETIN OF THE AMERICAN METEOROLOGICAL SOCIETY},
Year = {2025},
