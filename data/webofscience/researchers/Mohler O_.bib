@article{ WOS:001510216800001,
Author = {Katsivela, Eleftheria and Chatoutsidou, Sofia Eirini and Saridaki,
   Aggeliki and Raisi, Louiza and Stathopoulou, Panagiota and Tsiamis,
   Georgios and Kunfeng, Gao and Fetfatzis, Prodromos and Romanos, Foskinis
