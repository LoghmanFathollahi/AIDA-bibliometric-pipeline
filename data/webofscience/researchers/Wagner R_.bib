
@article{ WOS:000267082200011,
Author = {Wagner, Robert and Linke, Claudia and Naumann, Karl-Heinz and Schnaiter,
   Martin and Vragel, Marlen and Gangl, Martin and Horvath, Helmuth},
Title = {A review of optical measurements at the aerosol and cloud chamber AIDA},
Journal = {JOURNAL OF QUANTITATIVE SPECTROSCOPY \& RADIATIVE TRANSFER},
Year = {2009},
Volume = {110},
