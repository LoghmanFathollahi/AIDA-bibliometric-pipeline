@article{ WOS:000352292500019,
Author = {Kuehnreich, B. and Wagner, S. and Habig, J. C. and Moehler, O. and
   Saathoff, H. and Ebert, V.},
Title = {Time-multiplexed open-path TDLAS spectrometer for dynamic,
   sampling-free, interstitial H2 18O and
   H2 16O vapor detection in ice clouds},
Journal = {APPLIED PHYSICS B-LASERS AND OPTICS},
Year = {2015},
Volume = {119},
Number = {1, SI},
Pages = {177-187},
Month = {APR},
Note = {4th International Conferene on Field Laser Applications in Industry and
   Research, Firenze, ITALY, MAY 05-09, 2014},
Abstract = {An advanced in situ diode laser hygrometer for simultaneous,
   sampling-free detection of interstitial H-2 O-16 and H-2 O-18 vapor was
   developed and tested in the aerosol interaction and dynamics in
   atmosphere (AIDA) cloud chamber during dynamic cloud formation
   processes. The spectrometer to measure isotope-resolved water vapor
   concentrations comprises two rapidly time-multiplexed DFB lasers near
   1.4 and 2.7 A mu m and an open-path White cell with 227-m absorption
   path length and 4-m mirror separation. A dynamic water concentration
   range from 2.6 ppb to 87 ppm for H-2 O-16 and 87 ppt to 3.6 ppm for H-2
   O-18 could be achieved and was used to enable a fast and direct
   detection of dynamic isotope ratio changes during ice cloud formation in
   the AIDA chamber at temperatures between 190 and 230 K. Relative changes
   in the H-2 O-18/H-2 O-16 isotope ratio of 1 \% could be detected and
   resolved with a signal-to-noise ratio of 7. This converts to an isotope
   ratio resolution limit of 0.15 \% at 1-s time resolution.},
