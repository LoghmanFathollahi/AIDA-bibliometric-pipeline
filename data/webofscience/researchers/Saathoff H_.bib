@article{ WOS:A1993KZ44600057,
Author = {SAATHOFF, H and ZELLNER, R},
Title = {LIF DETECTION OF THE CF3O RADICAL AND KINETICS OF ITS REACTIONS WITH CH4
   AND C2H6},
Journal = {CHEMICAL PHYSICS LETTERS},
Year = {1993},
Volume = {206},
Number = {1-4},
Pages = {349-354},
Month = {APR 30},
Abstract = {Fluorescence excitation and dispersed fluorescence spectra of the X 2E-A
   2A1 transition of the trifluoromethoxy radical have been measured using
   laser excitation in the range 336-358 nm. The spectra are dominated by
   the features of the CO stretching and the OCF deformation mode. The LIF
   technique has been used to study the kinetics of the reactions of CF3O(X
   2E) radicals with CH4 (5) and C2H6 (6). Rate coefficients of k5=(2.2 +/-
   0.2) x 10(-14) and k6=(1.2 +/- 0.2) X 10(-12) cm3/s at 298 K have been
   determined.},
