@article{ WOS:001215401800001,
Author = {Seidel, Johanna S. and Kiselev, Alexei A. and Keinert, Alice and
   Stratmann, Frank and Leisner, Thomas and Hartmann, Susan},
Title = {Secondary ice production - no evidence of efficient rime-splintering
   mechanism},
Journal = {ATMOSPHERIC CHEMISTRY AND PHYSICS},
Year = {2024},
