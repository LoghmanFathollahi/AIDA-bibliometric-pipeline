@article{ WOS:000079134300029,
Author = {Busolt, U and Cottancin, E and Röhr, H and Socaciu, L and Leisner, T and
   Wöste, L},
Title = {Cluster-surface interaction studied by time-resolved two-photon
   photoemission},
Journal = {APPLIED PHYSICS B-LASERS AND OPTICS},
Year = {1999},
Volume = {68},
Number = {3},
Pages = {453-457},
Month = {MAR},
Note = {206th WE Heraeus Seminar Nonlinear Optics at Interfaces (NOPTI 98),
   MAX-PLANCK-GESELL, HARNACK HAUS, BERLIN, GERMANY, SEP 21-24, 1998},
Organization = {Deutsch Forsch Gemeinschaft; Freie Univ Berlin; Max-Planck-Gesell,
   Fritz-Haber Inst; Goherent GmbH; Lambda Physik; Omicron; Spectra Phys;
   Springer-Verlag},
Abstract = {We use time-resolved two-photon photoemission to study the stability of
   size selected Ag-n(+) clusters (n = 2 - 9) deposited onto highly
   oriented pyrolytic graphite (HOPG) substrates at liquid nitrogen
   temperatures. The deposition was carried out with variable kinetic
   energies of the clusters. Clusters deposited with high kinetic energy
   (up to 60 eV/cluster) become fragmented upon impact. For low deposition
   energies (1-4 eV/cluster) the size dependence of the photoelectron
   spectra reveals a pronounced odd/even effect, which is well known for
   gas phase silver clusters. This indicates that the soft deposited
   clusters retain their size and identity on the sample. The phase of the
   odd/even effect suggests that transient negatively charged cluster ions
   serve as an intermediate step in the two-photon photoemission process.
   The lifetime of the anions rises with cluster size. This is attributed
   to an increasing electronic density of states for larger clusters.},
