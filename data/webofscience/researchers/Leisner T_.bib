@article{ WOS:000227734400018,
Author = {Stöckel, P and Weidinger, IM and Baumgärtel, H and Leisner, T},
Title = {Rates of homogeneous ice nucleation in levitated H2O and
   D2O droplets},
Journal = {JOURNAL OF PHYSICAL CHEMISTRY A},
Year = {2005},
Volume = {109},
Number = {11},
Pages = {2540-2546},
Month = {MAR 24},
Abstract = {Rates of homogeneous nucleation of H2O droplets in a temperature range
   from 236.37 to 237.91 K and of D2O droplets from 241.34 to 242.33 K were
   measured. The single microdroplets consisted of pure H2O or D2O and were
   levitated in an electrodynamic balance. In comparison to H2O, D2O shows
   a stronger tendency to nucleate. Over the investigated temperature
   interval, D2O droplets need to be supercooled less by 1.1 K compared to
   H2O droplets in order to arrive at the same nucleation rate. This is in
   good agreement with the higher degree of intermolecular association in
   liquid D2O , a fact which has been well established previously both from
   theory and experimental studies.},
