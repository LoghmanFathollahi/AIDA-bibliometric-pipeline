@article{ WOS:001190492200001,
Author = {Jiang, Feng and Siemens, Kyla and Linke, Claudia and Li, Yanxia and
   Gong, Yiwei and Leisner, Thomas and Laskin, Alexander and Saathoff,
   Harald},
Title = {Molecular analysis of secondary organic aerosol and brown carbon from
   the oxidation of indole},
Journal = {ATMOSPHERIC CHEMISTRY AND PHYSICS},
Year = {2024},
Volume = {24},
Number = {4},
Pages = {2639-2649},
Month = {FEB 29},
Abstract = {Indole (ind) is a nitrogen-containing heterocyclic volatile organic
   compound commonly emitted from animal husbandry and from different
   plants like maize with global emissions of 0.1 Tg yr - 1 . The chemical
   composition and optical properties of indole secondary organic aerosol
   (SOA) and brown carbon (BrC) are still not well understood. To address
   this, environmental chamber experiments were conducted to investigate
   the oxidation of indole at atmospherically relevant concentrations of
   selected oxidants (OH radicals and O 3 ) with or without NO 2 . In the
   presence of NO 2 , the SOA yields decreased by more than a factor of 2,
   but the mass absorption coefficient at 365 nm (MAC 365 ) of ind-SOA was
   4.3 +/- 0.4 m 2 g - 1 , which was 5 times higher than that in
   experiments without NO 2 . In the presence of NO 2 , C 8 H 6 N 2 O 2
   (identified as 3-nitroindole) contributed 76 \% to all organic compounds
   detected by a chemical ionization mass spectrometer, contributing
   similar to 50 \% of the light absorption at 365 nm (Abs 365 ). In the
   absence of NO 2 , the dominating chromophore was C 8 H 7 O 3 N,
   contributing to 20 \%-30 \% of Abs 365 . Indole contributes
   substantially to the formation of secondary BrC and its potential impact
   on the atmospheric radiative transfer is further enhanced in the
   presence of NO 2 , as it significantly increases the specific light
   absorption of ind-SOA by facilitating the formation of 3-nitroindole.
