   and Vezin, B and Boutou, V and Leisner, T and Hubner, W and Wolf, JP and
   Woste, L and Bennemann, KH},
Title = {Angular dependences of third harmonic generation from microdroplets},
Journal = {PHYSICAL REVIEW LETTERS},
Year = {1997},
Volume = {78},
Number = {15},
Pages = {2952-2955},
Month = {APR 14},
Abstract = {We present experimental and theoretical results for the angular
   dependence of third harmonic generation of water droplets in the
   micrometer range (size parameter 62 < ka < 248). The third harmonic
   generation signal in p and s polarization obtained with ultrashort laser
   pulses is compared with a recently developed nonlinear extension of
   classical Mie theory including multipoles of order l less than or equal
   to 250. Both theory and experiment yield over a wide range of size
   parameters remarkably stable intensity maxima close to the forward and
   backward direction at `'magic angles.'' In contrast to linear Mie
   scattering, both are of comparable intensity.},
