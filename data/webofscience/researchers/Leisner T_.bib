@article{ WOS:000230562700069,
Author = {Achtzehn, T and Müller, R and Duft, D and Leisner, T},
Title = {The Coulomb instability of charged microdroplets: dynamics and scaling},
Journal = {EUROPEAN PHYSICAL JOURNAL D},
Year = {2005},
Volume = {34},
Number = {1-3},
Pages = {311-313},
Month = {JUL},
Note = {12th International Symposium on Small Particles and Inorganic Clusters,
   Nanjing, PEOPLES R CHINA, SEP 06-10, 2004},
Organization = {Natl Nat Sci Fdn China; Minist Educ China; Chinese Acad Sci; Natl Lab
   Heavy Ion Accelerator Lanzhou; Chinese Phys Soc; Int Ctr Mat Res China;
   Govt Jiagsu Provine; Nanjing Municipal; Nanjing Univ; Natl Lab Solid
   State Microstruct},
Abstract = {The stability and disintegration dynamics of evaporating highly charged
   liquid droplets from ethylene glycol and glycerol is investigated by
   ultrafast microscopy and analyzed as a function of temperature and
   droplet size. In the moment of instability the droplets have deformed to
   elongated spindle like shapes from which pairs of opposite jets of
   highly charged liquid are emitted. The thickness of the jets and the
   shape of the deformed droplet are remarkably insensitive to the size and
   viscosity of the unstable droplet, while the speed of disintegration is
   found to scale with a power law for both variables, the exponent being
   close to 3/2.},
