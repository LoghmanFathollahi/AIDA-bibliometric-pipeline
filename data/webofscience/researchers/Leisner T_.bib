@article{ WOS:000172039400068,
Author = {Busolt, U and Cottancin, E and Socaciu, L and Röhr, H and Leisner, T and
   Wöste, L},
Title = {Diffusion and aggregation of Agn-Clusters (n=2-9) on
   HOPG probed by fs-two-photon-photoemission},
Journal = {EUROPEAN PHYSICAL JOURNAL D},
Year = {2001},
Volume = {16},
Number = {1-3},
Pages = {297-300},
Month = {SEP},
Note = {10th International Symposium on Small Particles and Inorganic Clusters
   (ISSPIC 10), ATLANTA, GEORGIA, OCT 11-15, 2000},
Organization = {Georgia Inst Technol; USAF, Off Sci Res},
Abstract = {The diffusion and aggregation of preformed Ag.-clusters (n = 2-9)
   deposited onto a highly oriented pyrolytic graphite (HOPG) substrate is
   studied by two-photon-photoemission (2PPE). The sample is irradiated
   with ultrashort laser pulse pairs and the kinetic energy of the emitted
   photoelectrons is analyzed in a magnetic bottle typo thue-of-flight
   spectrometer. During annealing of the sample from 100 K up to room
   temperature, nanoparticles arc formed on the surface by diffusion and
   aggregation of the silver clusters. A steep increase of the total
   photoelectron yield at a sample temperature of about 150 K is explained
   by the. excitation of plasmons in the silver nanoparticles. From the
   kinetic energy distribution of the photoelectrons we deduce a strong
   variation of the work function of the sample during the formation of the
   nanoparticles, which is attributed to a quantum size effect.},
