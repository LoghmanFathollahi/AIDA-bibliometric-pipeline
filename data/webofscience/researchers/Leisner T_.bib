@article{ WOS:000202837500019,
Author = {Weritz, F and Simon, A and Leisner, T},
Title = {Infrared microspectroscopy on single levitated droplets},
Journal = {ENVIRONMENTAL SCIENCE AND POLLUTION RESEARCH},
Year = {2002},
Number = {4},
Pages = {92-99},
Abstract = {We report the first direct FTIR spectra of single levitated droplets.
   Recent progress in FTIR microscopy in combination with levitation
   techniques allows to investigate spherical levitated droplets with a
   mass down to 1 ng. The droplet spectra are strongly influenced by light
   scattering owing to the spherical geometry of the sample. The resultant
   spectra can be analyzed by Mie theory, however, and substance specific
   information can be obtained. We present details of our experimental
   setup which combines an electrodynamic levitator and a climate chamber
   for low temperature experiments with a FTIR microscope. This allows to
   investigate atmospheric aerosol droplets and their dynamics in real time
   and under realistic atmospheric conditions. Model spectra of ethylene
   glycol and MgCl2 solutions are presented and the effects of absorption
   and scattering are discussed separately to elucidate the prospects and
   limitations of this technique.},
