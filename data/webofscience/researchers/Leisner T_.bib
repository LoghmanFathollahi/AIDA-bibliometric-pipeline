@article{ WOS:000172039400033,
Author = {Hess, H and Asmis, KR and Leisner, T and Wöste, L},
Title = {Vibrational wave packet dynamics in the silver tetramer probed by NeNePo
   femtosecond pump-probe spectroscopy},
Journal = {EUROPEAN PHYSICAL JOURNAL D},
Year = {2001},
Volume = {16},
Number = {1-3},
Pages = {145-149},
Month = {SEP},
Note = {10th International Symposium on Small Particles and Inorganic Clusters
   (ISSPIC 10), ATLANTA, GA, OCT 11-15, 2000},
Organization = {Georgia Inst Technol; USAF, Off Sci Res},
Abstract = {We present results on the ultrafast dynamics of mass-selected neutral
   Ag(4) clusters using NeNePo (negative ion - neutral - positive ion)
   femtosecond pump-probe spectroscopy. One-color pump-probe spectra of the
   Ag(4)(-)/Ag(4)/Ag(4)(+) system measured at 385 nm and an internal
   cluster temperature of 20 K display a complex beat structure over more
   than 60 ps. The oscillatory structure is attributed to vibrational wave
   packet dynamics in an excited ``dark{''} state of neutral Ag(4). A
   dominant 740 fs wave packet period as well as wave packet dephasing and
   rephasing are observed in the spectra. Fourier analysis of the spectra
   yields a group of frequencies centered around 45 cm(-1) and an
   anharmonicity \textbackslash{}2 nu (0)chi (c)\textbackslash{} of 2.65
   cm(-1) for the active vibrational mode.},
