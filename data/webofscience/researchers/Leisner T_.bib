Journal = {EUROPEAN PHYSICAL JOURNAL D},
Year = {1998},
Volume = {4},
Number = {2},
Pages = {231-238},
Month = {NOV},
Abstract = {In this paper, we present an overview of the capabilities of linear and
   non-linear spectroscopy for the 3D-analysis of gaseous pollutants and
   aerosols in the atmosphere. The basic technique is Lidar (Light
   Detection and Ranging). Results obtained in Sevilla and Lyon about the
   ozone smog formation and the dynamics of the transport of dust
   particles;are presented. Finally, non-linear Mie scattering on
   atmospheric aerosols has been demonstrated in the laboratory, opening
   new perspectives for remote sensing.},
