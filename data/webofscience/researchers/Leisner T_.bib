@article{ WOS:001021441200001,
Author = {Iskandar, Sabrina E. and Chiou, Lilly F. and Leisner, Tina M. and Shell,
   Devan J. and Norris-Drouin, Jacqueline L. and Vaziri, Cyrus and Pearce,
   Kenneth H. and Bowers, Albert A.},
Title = {Identification of Covalent Cyclic Peptide Inhibitors in mRNA Display},
