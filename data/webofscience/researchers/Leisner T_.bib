@article{ WOS:000223922900017,
Author = {Lindinger, A and Hagen, J and Socaciu, LD and Bernhardt, TM and Wöste, L
   and Duft, D and Leisner, T},
Title = {Time-resolved explosion dynamics of H2O droplets induced by
   femtosecond laser pulses},
Journal = {APPLIED OPTICS},
Year = {2004},
Volume = {43},
Number = {27},
Pages = {5263-5269},
Month = {SEP 20},
Abstract = {Series of time-resolved still images of the explosion dynamics of
   micrometer-sized water droplets after femtosecond laser-pulse
   irradiation were obtained for different laser-pulse intensities.
   Amplified pulses centered around a wavelength of 805 nm with 1-mJ energy
   and 60-fs duration were focused onto the droplet to initiate the
   dynamics. Several effects, such as forward and backward plumes, jets,
   water films, and shock waves, were investigated. Additionally, the
   influence of different pulse durations produced by chirping the laser
   pulses was observed. (C) 2004 Optical Society of America.},
