@article{ WOS:A1985ART3800014,
Author = {GLAVAS, S and SCHURATH, U},
Title = {PEROXYACETYL NITRATE FORMING POTENTIAL OF 5 PROTOTYPE HYDROCARBONS},
Journal = {ENVIRONMENTAL SCIENCE \& TECHNOLOGY},
Year = {1985},
Volume = {19},
Number = {10},
Pages = {950-955},
Abstract = {The peroxyacetyl nitrate (PAN) forming potential of trans-butene,
   propene, ethene, n-butane, and toluene in the single
   hydrocarbon/NO2/synthetic air system was probed in 61 smog chamber
   experiments. Butene was studied over an extended range of concentrations
   and concentration ratios. Maximum yields, which are expressed in percent
   NO2 converted to PAN, were approximately 50\% for trans-butene, 33\% for
   propene, and 6\% for toluene, for irradiation of 100 ppb of NO2 and >
   600 ppb of hydrocarbon.  No PAN maxima were obtained in 5-6-h
   irradiations of ethene and n-butane, but PAN formation rates were linear
   over extended time periods and could be compared. They ranged from 0.005
   ppb/min for ethene to 2 ppb/min for trans-butene, at a nitrogen dioxide
   photolysis rate of 0.35 min-1.},
