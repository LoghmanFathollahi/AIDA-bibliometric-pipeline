@article{ WOS:A1993MC24800002,
Author = {GUSTEN, H and SCHURATH, U},
Title = {A NOVEL OZONE SENSOR WITH VARIOUS ENVIRONMENTAL APPLICATIONS},
Journal = {PTB-MITTEILUNGEN},
Year = {1993},
Volume = {103},
Number = {4},
Pages = {324-328},
Month = {AUG},
Abstract = {A small, lightweight and fast-response ozone sonsor has been developed
   for various environmental applications. At a sampling rate of 100 l
   min-1 the sensor can detect variations of less than 100 pptv in ozone
   mixing ratio with a time resolution of better than 0.1 s. Recent
   successful environmetal applications of the sensor include direct
   measurements of vertical turbulent ozone flux onto agricultural land by
   the eddy correlation or covariance technique. The low weight and power
   consumption of the device renders possible high resolution measurements
   of horizontal/vertical ozone profiles in the troposphere and
   stratosphere.},
Publisher = {FRIEDR VIEWEG SOHN VERLAG GMBH},
