@article{ WOS:000080920700014,
Author = {Langenberg, S and Schurath, U},
Title = {Ozone destruction on ice},
Journal = {GEOPHYSICAL RESEARCH LETTERS},
Year = {1999},
Volume = {26},
Number = {12},
Pages = {1695-1698},
Month = {JUN 15},
Abstract = {The destruction of ozone on ice surfaces was studied with;tn ice-coated
   fused silica column used as a very long flow tube. Ozone destruction was
   found to be very slow. At :223 K and 258 K the measured reaction
   probabilities fall in the range 2 x 10(-8) - 4 x 10(-10), decreasing
   with increasing ozone concentration (20 - 1000 nbar). The observed
   kinetics are explained by an at least two step mechanism. The bn
   reaction rates observed are insignificant for ozone destruction in
   cirrus clouds.},
