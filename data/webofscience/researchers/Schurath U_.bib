@article{ WOS:A1992JD74100004,
Author = {MINESHOS, G and GLAVAS, S and SCHURATH, U},
Title = {REACTIONS OF PEROXYACETYL RADICALS WITH REDUCED SULFUR-COMPOUNDS},
Journal = {MONATSHEFTE FUR CHEMIE},
Year = {1992},
Volume = {123},
Number = {6-7},
Pages = {501-508},
Month = {JUN-JUL},
Abstract = {The reaction of peroxyacetyl radicals with reduced sulfur compounds was
   studied at 55-degrees-C in N2 at 1000 mbar total pressure. The radicals
   were generated in equilibrium with peroxyacetyl nitrate and NO2 in large
   excess. The pseudo first order decay of PAN was measured in the absence
   and presence of several 100 ppm CH3SH, C2H5SH, n-C4H9SH, (CH3)2S, and
   (CH3S)2. Computer simulations yielded the following rate constants of
   peroxyacetyl radicals with the above mentioned sulfur compounds: 3.7,
   2.8, 13.0, 0.9, and 1.8.10(-16) cm3/s, respectively. An electron
   capturing compound of the thiols with NO2 was observed.},
Publisher = {SPRINGER-VERLAG WIEN},
Address = {SACHSENPLATZ 4-6, PO BOX 89, A-1201 VIENNA, AUSTRIA},
Type = {Article},
Language = {English},
Affiliation = {UNIV PATRAS,DEPT CHEM,GR-26110 PATRAI,GREECE.
   UNIV BONN,INST PHYS CHEM,W-5300 BONN,GERMANY.},
