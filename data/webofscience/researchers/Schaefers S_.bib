@article{ WOS:000606544300007,
Author = {Froede, Lennart and Schaefers, Sebastian and Wagenpfeil, Gudrun and
   Raddatz, Alexander and Hoffmann, Klaus and Schaefer, Hans-Joachim},
Title = {Simplified determination of commissural orientation in bicuspid aortic
   valves},
Journal = {EUROPEAN JOURNAL OF CARDIO-THORACIC SURGERY},
Year = {2020},
Volume = {58},
Number = {6},
Pages = {1153-1160},
Month = {DEC},
Abstract = {OBJECTIVES: In bicuspid aortic valves (BAV), commissural orientation
   (CO) varies between 180 degrees and close to 120 degrees. Postoperative
   CO has a strong effect on repair durability, and different repair
   approaches have been proposed according to CO; it is thus important for
   aortic repair. A precise, simple and reproducible determination by
   preoperative echocardiography would facilitate intraoperative
   decision-making. We compared 4 different methods of determination of CO
   in BAV.
   METHODS: Preoperative transoesophageal echocardiograms of 62 patients
   with BAV were analysed. CO was measured using either the coaptation
   centre or the geometric centre of the root. The geometric centre of the
   root was determined through approximation using a circle or an ellipse,
   or the midpoint of a line between the centre of the non-fused and the
   fused sinuses.
   RESULTS: The 3 different geometric methods led to almost identical
   results (interclass coefficient 0.98-0.99), with the line segment being
   the easiest to use. The use of the coaptation centre was associated with
   the underestimation of commissural angle of up to 30 degrees compared to
   the geometric centre; the discrepancy was significant and most
   pronounced for asymmetric BAV (140-160 degrees; P=0.005).
   CONCLUSIONS: CO can reproducibly be determined using a line segment
   between the centre of the non-fused and fused sinuses. The use of the
   coaptation centre can lead to misleading results, in particular in
   asymmetric BAVs.},
