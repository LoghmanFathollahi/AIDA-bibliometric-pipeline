Title = {Biological and dust aerosols as sources of ice-nucleating particles in
   the eastern Mediterranean: source apportionment, atmospheric processing
   and parameterization},
Journal = {ATMOSPHERIC CHEMISTRY AND PHYSICS},
Year = {2024},
