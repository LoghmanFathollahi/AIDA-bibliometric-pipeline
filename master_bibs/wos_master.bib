Title = {Overview of the Antarctic Circumnavigation Expedition: Study of
   Preindustrial-like Aerosols and Their Climate Effects (ACE-SPACE)},
Journal = {BULLETIN OF THE AMERICAN METEOROLOGICAL SOCIETY},
Year = {2019},
