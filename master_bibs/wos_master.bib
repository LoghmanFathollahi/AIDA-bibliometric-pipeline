@article{WOS001602862100001,
Author = {Wang, Kaiqi and Bi, Kai and Chen, Shuling and Hartmann, Markus and Wu,
   Zhijun and Gao, Jiyu and Xu, Xiaoyu and Cheng, Yuhan and Huang, Mengyu
   and Chen, Yunbo and Xue, Huiwen and Wang, Bingbing and Hu, Yaqiong and
   Zhang, Xiongying and Ma, Xincheng and Li, Ruijie and Tian, Ping and
   Mohler, Ottmar and Wex, Heike and Stratmann, Frank and Chen, Jie and
   Gong, Xianda},
Title = {An improved Freezing Ice Nucleation Detection Analyzer (FINDA) for
   droplet immersion freezing measurement},
Journal = {ATMOSPHERIC MEASUREMENT TECHNIQUES},
Year = {2025},
Volume = {18},
Number = {20},
Pages = {5823-5840},
Month = {OCT 29},
Abstract = {Heterogeneous ice nucleation initiated by atmospheric ice-nucleating
   particles (INPs) is a key microphysical process for cloud formation.
   Detecting the ice nucleation ability (INA) and concentration of INPs is
   essential for improving global climate models. Droplet freezing
   techniques (DFTs) are among the widely used tools for measuring the
   immersion freezing of INPs, which is a predominant ice nucleation
   process in mixed-phase clouds. To enhance the efficiency and accuracy of
   DFTs, we developed a Freezing Ice Nucleation Detection Analyzer at
   Westlake University (FINDA-WLU) with an improved hardware setup,
   user-friendly software, precise droplet freezing detection, and rigorous
   temperature calibrations. The temperature uncertainty of FINDA-WLU is
   about +/- 0.60 degrees C, considering both vertical heat transfer
   efficiency and horizontal temperature heterogeneity. The system is
   tested with Milli-Q ultrapure water and reference materials like Arizona
   Test Dust and Snomax (R), and the results are consistent with previous
   studies. We also use the FINDA-WLU to measure INPs in precipitation
   samples collected in China. Overall, FINDA-WLU proved to be a reliable
   and precise method for measuring INA and INP concentrations.},
