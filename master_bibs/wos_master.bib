Author = {Ignatius, Karoliina and Kristensen, Thomas B. and Jaervinen, Emma and
   Nichman, Leonid and Fuchs, Claudia and Gordon, Hamish and Herenz, Paul
   and Hoyle, Christopher R. and Duplissy, Jonathan and Garimella, Sarvesh
